# Curated QEMU/KVM machine profile.
# Keep only top-level virtual/emulated hardware drivers here. Dependencies
# are resolved automatically by modprobe; filesystem modules belong in the
# normal filesystem configuration, not in a machine profile.

# VirtIO devices
module virtio_blk
module virtio_scsi
module virtio_net
module virtio_console
module virtio_balloon
module virtio_rng

# Common QEMU/KVM storage controllers
module ahci
module ata_piix
module megaraid_sas
module mptspi

# Common emulated network adapters
module e1000
module e1000e
module pcnet32
module 8139cp
module 8139too

# Common virtual display adapters
module qxl
module bochs

# Common emulated audio
module snd-intel8x0
module snd-hda-intel

# Miscellaneous QEMU virtual hardware
module qemu_fw_cfg
module floppy
module parport_pc
module virtio_input
