# Curated VMware machine profile.
# Keep only top-level virtual/emulated hardware drivers. Dependencies are
# resolved automatically; filesystem modules belong in filesystem config.

# VMware paravirtual devices
module vmxnet3
module vmw_pvscsi
module vmw_balloon
module vmw_vmci
module vmw_vsock_vmci_transport
module vmwgfx

# Common VMware emulated storage controllers
module ahci
module ata_piix
module mptspi

# Common VMware emulated network adapters
module e1000
module e1000e
module pcnet32

# Common VMware emulated audio
module snd-ens1371
module snd-hda-intel

# Miscellaneous emulated hardware
module parport_pc
