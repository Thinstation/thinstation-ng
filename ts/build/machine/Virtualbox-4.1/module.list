# Curated VirtualBox machine profile.
# Keep only top-level virtual/emulated hardware drivers. Dependencies are
# resolved automatically; filesystem modules such as vboxsf are excluded.

# VirtualBox guest devices
module vboxguest
module vboxvideo

# Common VirtualBox storage controllers
module ahci
module ata_piix
module nvme

# Common VirtualBox network adapters
module e1000
module e1000e
module pcnet32
module virtio_net

# Common VirtualBox audio controllers
module snd-intel8x0
module snd-hda-intel

# Miscellaneous emulated hardware
module parport_pc
