#!/bin/sh

RES="$(xrandr | awk '/\*/ {print $1; exit}')"
DST_W="${RES%x*}"
DST_H="${RES#*x}"

cat << EOF > /etc/banner-scaled.svg
<svg xmlns="http://www.w3.org/2000/svg"
     width="$DST_W" height="$DST_H"
     viewBox="0 0 $DST_W $DST_H">
  <rect width="$DST_W" height="$DST_H" fill="black"/>
EOF

cat /etc/banner.svg >> /etc/banner-scaled.svg

cat << EOF >> /etc/banner-scaled.svg
</svg>
EOF
