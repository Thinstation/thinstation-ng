#lightdm 29

LDM_CONF=/etc/lightdm/lightdm.conf

rm /etc/systemd/system/display-manager.service
systemctl enable lightdm

mkdir -p /var/lib/lightdm/.cache/lightdm-gtk-greeter
chown -R lightdm:lightdm /var/lib/lightdm

sed -i -e "s/tsuser/$TSUSER/g" $LDM_CONF

if is_enabled $LIGHTDM_BANNER; then

	LDMG_CONF=/etc/lightdm/lightdm-gtk-greeter.conf
	BANNER_SRC=banner.svg
	cp /build/$BANNER_SRC /etc/banner.svg

	sed -i -e '/^autologin/d'		$LDM_CONF
	sed -i 's|^#\?greeter-setup-script=.*|greeter-setup-script=/usr/bin/lightdm-banner|' $LDM_CONF

	sed -i -e '/^background/d'		$LDMG_CONF
	echo "theme-name = Adwaita"             >> $LDMG_CONF
	echo "background=/etc/banner-scaled.svg"	>> $LDMG_CONF
	echo "position = 50%,center 80%,center" >> $LDMG_CONF
	echo "screensaver-timeout = 60"		>> $LDMG_CONF
	echo "user-background = false"		>> $LDMG_CONF
	echo "default-user-image = /usr/share/icons/hicolor/128x128/apps/ThinStation.png" >> $LDMG_CONF

fi
