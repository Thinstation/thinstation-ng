#openssh 35

# ThinStation appliances use the normal daemon, not Accept=yes socket activation.
# This keeps sshd behind tsinit/network setup and avoids early per-connection
# sshd@ instances racing host-key/persistent-state initialization.
/usr/lib/systemd/systemd-update-helper install-system-units sshd.service
rm -f /etc/systemd/system/sockets.target.wants/sshd.socket

install -d -m 0755 /etc/ssh/sshd_config.d
cat <<'EOC' > /etc/ssh/sshd_config.d/60-thinstation-debug.conf
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin prohibit-password
EOC
