#!/bin/sh
set -eu
CONF=/etc/mcp-appliance/lego.conf
[ -r "$CONF" ] || { echo "lego is not configured: $CONF missing" >&2; exit 2; }
. "$CONF"
[ "${LEGO_ENABLED:-false}" = true ] || exit 0
LEGO_PATH=${LEGO_PATH:-/var/prstnt/mcp-appliance/lego}
mkdir -p "$LEGO_PATH"
: "${LEGO_EMAIL:?LEGO_EMAIL is required}"
: "${LEGO_DOMAINS:?LEGO_DOMAINS is required}"
: "${LEGO_DNS_PROVIDER:?LEGO_DNS_PROVIDER is required}"
set --
for d in $LEGO_DOMAINS; do set -- "$@" --domains "$d"; done
lego --path "$LEGO_PATH" --accept-tos --email "$LEGO_EMAIL" --dns "$LEGO_DNS_PROVIDER" "$@" run
if [ -n "${LEGO_DEPLOY_HOOK:-}" ]; then "$LEGO_DEPLOY_HOOK"; fi
