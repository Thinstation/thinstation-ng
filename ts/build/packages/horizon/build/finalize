#horizon 70

#. /build/scripts/Omnissa-Horizon-Client_postinstall.sh

systemctl enable horizon-init

ln -s /usr/lib64/libudev.so.1 /usr/lib64/omnissa/libudev.so.0
ln -s /usr/lib64/libsecret-1.so.0 /usr/lib64/omnissa/libsecret.so

