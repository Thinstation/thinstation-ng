mkdir -p /ts/build/packages/devstation/bin
mkdir -p /ts/build/packages/devstation/sbin
ln /usr/bin/chage /ts/build/packages/devstation/bin/chage
ln /usr/bin/chgpasswd /ts/build/packages/devstation/sbin/chgpasswd
ln /usr/bin/chpasswd /ts/build/packages/devstation/sbin/chpasswd
ln /usr/bin/diff /ts/build/packages/devstation/bin/diff
ln /usr/bin/groupadd /ts/build/packages/devstation/sbin/groupadd
ln /usr/bin/groupdel /ts/build/packages/devstation/sbin/groupdel
ln /usr/bin/groupmod /ts/build/packages/devstation/sbin/groupmod
ln /usr/bin/useradd /ts/build/packages/devstation/bin/useradd
ln /usr/bin/userdel /ts/build/packages/devstation/sbin/userdel
ln /usr/bin/usermod /ts/build/packages/devstation/sbin/usermod
ln -sf /bin/useradd /ts/build/packages/devstation/sbin/useradd
