[Unit]
Description=K3s Lightweight Kubernetes
Documentation=https://docs.k3s.io/
Wants=network-online.target
After=network-online.target persistent-files.service persistent-dirs.service fastboot.service k3s-storage-mount.service k3s-image-sync.service
ConditionPathExists=/var/lib/rancher/k3s/.configured

[Service]
Type=notify
EnvironmentFile=-/etc/default/k3s
KillMode=process
Delegate=yes
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s
StandardOutput=journal+console
StandardError=journal+console
ExecStart=/usr/bin/k3s server --config /etc/rancher/k3s/config.yaml

[Install]
WantedBy=multi-user.target
