msgid "Username"
msgstr "ユーザー名"

msgid "Password"
msgstr "パスワード"

msgid "Username and Server"
msgstr "ユーザー名とサーバー"

msgid "Server DNS name or IP address"
msgstr "サーバーのDNS名またはIPアドレス"

msgid "type server name here"
msgstr "ここにサーバー名を入力"

msgid "Options"
msgstr "オプション"

msgid "Windowed"
msgstr "ウィンドウ表示"

msgid "Exit"
msgstr "終了"

msgid "Connect"
msgstr "接続"

msgid "Authentication"
msgstr "認証"

msgid "Connection"
msgstr "接続"

msgid "Kiosk Progress"
msgstr "キオスクの進行状況"

msgid "Scanning"
msgstr "スキャン中"

msgid "Waiting for 'PACKAGE' network."
msgstr "'PACKAGE'のネットワークを待機中。"

msgid "Timed out waiting for network!"
msgstr "ネットワーク待機がタイムアウトしました！"

msgid "Network"
msgstr "ネットワーク"

