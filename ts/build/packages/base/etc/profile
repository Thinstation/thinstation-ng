#/etc/profile: system-wide .profile file for ash.

trap "" INT QUIT TSTP
. /etc/thinstation.global

if [ "`id -u`" != "0" ]; then
	umask 027
else
	umask 022
fi

if ! readlink /bin/ls |grep -qe busybox; then
	export LS_COLORS='rs=0:di=01;34:ln=01;36:mh=00:pi=40;33:so=01;35:do=01;35:bd=40;33;01:cd=40;33;01:or=40;31;01:su=37;41:sg=30;43:ca=30;41:tw=30;42:ow=34;42:st=37;44:ex=01;32:*.cmd=01;32:*.exe=01;32:*.com=01;32:*.btm=01;32:*.bat=01;32:*.conf=01;33:*.tar=01;31:*.tgz=01;31:*.arj=01;31:*.taz=01;31:*.lzh=01;31:*.lzma=01;31:*.tlz=01;31:*.txz=01;31:*.zip=01;31:*.z=01;31:*.Z=01;31:*.dz=01;31:*.gz=01;31:*.lz=01;31:*.xz=01;31:*.bz2=01;31:*.bz=01;31:*.tbz=01;31:*.tbz2=01;31:*.tz=01;31:*.deb=01;31:*.rpm=01;31:*.jar=01;31:*.rar=01;31:*.ace=01;31:*.zoo=01;31:*.cpio=01;31:*.7z=01;31:*.rz=01;31:*.jpg=01;35:*.jpeg=01;35:*.gif=01;35:*.bmp=01;35:*.pbm=01;35:*.pgm=01;35:*.ppm=01;35:*.tga=01;35:*.xbm=01;35:*.xpm=01;35:*.tif=01;35:*.tiff=01;35:*.png=01;35:*.svg=01;35:*.svgz=01;35:*.mng=01;35:*.pcx=01;35:*.mov=01;35:*.mpg=01;35:*.mpeg=01;35:*.m2v=01;35:*.mkv=01;35:*.ogm=01;35:*.mp4=01;35:*.m4v=01;35:*.mp4v=01;35:*.vob=01;35:*.qt=01;35:*.nuv=01;35:*.wmv=01;35:*.asf=01;35:*.rm=01;35:*.rmvb=01;35:*.flc=01;35:*.avi=01;35:*.fli=01;35:*.flv=01;35:*.gl=01;35:*.dl=01;35:*.xcf=01;35:*.xwd=01;35:*.yuv=01;35:*.cgm=01;35:*.emf=01;35:*.axv=01;35:*.anx=01;35:*.ogv=01;35:*.ogx=01;35:*.aac=00;36:*.au=00;36:*.flac=00;36:*.mid=00;36:*.midi=00;36:*.mka=00;36:*.mp3=00;36:*.mpc=00;36:*.ogg=00;36:*.ra=00;36:*.wav=00;36:*.axa=00;36:*.oga=00;36:*.spx=00;36:*.xspf=00;36:'
        alias ls='ls --color=auto'
fi

if [ "`tty`" == "$CONSOLE" ]; then
	if [ -e $WKDIR/consoleapps ]; then
		show_cursor
		exec $WKDIR/consoleapps
	elif [ -e /bin/xinit ] && [ -e $WKDIR/windowapps ]; then
		if check_last_session; then
			cd /run
			exec /bin/xinit /etc/xinitrc -- /etc/xserverrc > $APPLOGDIR/session.$$ 2>&1
		elif is_disabled $HALTONERROR; then
			chvt 1
			echo "The system was not able to go graphical. This could indicate a problem with missing kernel modules or Xorg drivers."
			echo ""
		else
                        show_cursor
                        exec $NO_XORG_CMD
		fi
	fi
	chvt 1
	if ! is_disabled $FASTBOOT && ! systemctl is-active fastboot >/dev/null 2>&1; then
		echo "Fastboot was enabled, but something went wrong with the transfer or mount."
		echo "Hopefully only Administrators ever see this message, and then only when they fail. :)"
		echo "Review the log at /var/log/fastboot.log"
		if is_enabled $FASTBOOT; then
			mountpoint /lib64
		fi
		case $LM in
		hd)	if ! module_available vfat; then
				echo "hd: vfat module not available"
			else
				if ! mountpoint /boot >/dev/null; then
					echo "hd: /boot was not mounted, maybe check your mount declarations"
				fi
			fi
		;;
		pxe)
			if pkg_is_loaded networkmanager; then
				echo "pxe: Package networkmager does not work with this technology, try autonet"
			elif ! pkg_initialized autonet; then
				echo "pxe: Package autonet not available"
			else
				echo "pxe: Maybe we didn't get the server"
			fi
		;;
		iso)
			if ! module_available isofs && ! module_available udf; then
				echo "iso: No CD Rom modules available"
			else
				if ! mountpoint $BASE_MOUNT_PATH/cdrom0 >/dev/null; then
					echo "iso: $BASE_MOUNT_PATH/cdrom0 was not mounted, maybe check your mount declarations"
				fi
			fi
		;;
		*)
			echo "Fastboot enabled, but no loader method was defined, what are you doing?"
		;;
		esac
	else
		echo "There are no autostarted sessions!"
	fi
	echo ""
	show_cursor
        if is_disabled $HALTONERROR; then
		echo "Dropping to shell."
		echo ""
	else
		echo "Full Stop."
		halt
	fi
fi
show_cursor
trap - INT QUIT TSTP
