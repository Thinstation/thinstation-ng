#!/bin/sh

# /etc/mtab resolves through /proc/self/mounts; mount proc before querying mounts.
if [ ! -e /proc/self/mounts ]; then
	mount -t proc proc /proc
fi

if [ -z "`mount |grep -e overlay`" ]; then
	mount -t devtmpfs none /dev

	NEWROOT=/pivot
	mkdir -p $NEWROOT
	mount --make-rprivate /
	mount --rbind / $NEWROOT
	cd $NEWROOT
	mount --move . /
	exec /sbin/chroot . /sbin/init
fi
exec /sbin/init
