#!/bin/sh

export PACKAGE=kmod
export PORTS=$PACKAGE
export DROP_DIRS="usr/lib64/doc"
repackage -e

mkdir -p /ts/build/packages/kmod/usr/sbin
for link in depmod  insmod  lsmod  modinfo  modprobe  rmmod; do
	ln -sf /usr/bin/kmod /ts/build/packages/kmod/usr/sbin/$link
done
returnval=$?

exit $returnval
