#udsclient 60

# UDSClient Configuration
mimelist="/etc/xdg/mimeapps.list"

# Ensure the directory exists
mkdir -p "$(dirname "$mimelist")"

# Add the [Default Applications] section if it doesn't exist
if [ ! -e "$mimelist" ] || ! grep -q "^\[Default Applications\]" "$mimelist"; then
    echo '[Default Applications]' >> "$mimelist"
fi

# Append UDSClient handler
echo 'x-scheme-handler/udss=UDSClient.desktop' >> "$mimelist"

# Configure browser policies if UDS_BROKER_DNS_NAME is set
if [ -n "$UDS_BROKER_DNS_NAME" ]; then
    # Configure Chrome policy
    if command -v chrome >/dev/null; then
        mkdir -p /etc/opt/chrome/policies/managed

        cat <<EOF > /etc/opt/chrome/policies/managed/auto_open_policy.json
{
    "AutoLaunchProtocolsFromOrigins": [
        {
            "allowed_origins": ["https://$UDS_BROKER_DNS_NAME"],
            "protocol": "udss"
        }
    ]
}
EOF

        cat <<EOF > /etc/opt/chrome/policies/managed/password_policy.json
{
    "PasswordManagerEnabled": false
}
EOF
    fi

    # Configure Firefox permissions
    if command -v firefox >/dev/null; then
        sqlite3 /etc/TS.default/permissions.sqlite <<EOF
INSERT INTO moz_perms VALUES(1, 'https://$UDS_BROKER_DNS_NAME', 'storageAccessAPI', 1, 2, 1745781032135, 1741893032135);
INSERT INTO moz_perms VALUES(2, 'https://$UDS_BROKER_DNS_NAME', 'open-protocol-handler^udss', 1, 0, 0, 1741893063968);
EOF

    cat <<EOF>> /etc/TS.default/handlers.json
{"defaultHandlersVersion":{},"mimeTypes":{},"schemes":{"udss":{"action":4}},"isDownloadsImprovementsAlreadyMigrated":false}
EOF
    fi

    # Configure UDS Connector
    mkdir -p "/etc/skel/.config/Virtual Cable S.L.U."
    cat <<EOF > "/etc/skel/.config/Virtual Cable S.L.U./UDS Connector.conf"
[endpoints]
$UDS_BROKER_DNS_NAME=true
EOF
fi

# Configure FreeRDP if UDS_FREERDP_OPTIONS is set
if [ -n "$UDS_FREERDP_OPTIONS" ]; then
    if [ -e /usr/bin/xfreerdp ]; then
        mv /usr/bin/xfreerdp /usr/bin/xfreerdp.real
    fi

    cat <<EOF > /usr/bin/xfreerdp
#!/bin/bash
/bin/xfreerdp.real $UDS_FREERDP_OPTIONS "\$@"
EOF

    chmod +x /usr/bin/xfreerdp
fi
