#!/bin/bash

. /etc/thinstation.global

# The X11 session hook normally initializes this. Recheck on direct/restarted
# launches without restarting a healthy daemon or writing keyring files.
headless=false
kiosk=false
explicit_profile=false
for arg in "$@"; do
    case "$arg" in
        --headless|--headless=*) headless=true;;
        --kiosk) kiosk=true;;
        --user-data-dir|--user-data-dir=*) explicit_profile=true;;
    esac
done
keyring_args=()
if ! "$headless" && [[ ${KEYRING_MODE:-auto} != off ]]; then
    [[ -r /etc/thinstation-keyring.functions ]] || { echo 'Chrome: keyring integration is missing' >&2; exit 1; }
    . /etc/thinstation-keyring.functions
    thinstation_keyring_init && [[ ${TS_KEYRING_READY:-0} == 1 ]] || { echo 'Chrome: no unlocked keyring; refusing automatic basic-storage fallback' >&2; exit 1; }
    for arg in "$@"; do
        case "$arg" in
            --password-store=gnome-libsecret) ;;
            --password-store|--password-store=*) echo 'Chrome: conflicting password-store option; configure KEYRING_MODE explicitly' >&2; exit 1;;
        esac
    done
    keyring_args=(--password-store=gnome-libsecret)
fi

proxy_args=()
if [[ -e "$HOME/.proxy" ]]; then
    . "$HOME/.proxy"
    if [[ ${PROXY_HTTP:-} == TRUE ]]; then
        auth=${PROXY_AUTH:+${PROXY_AUTH}@}
        proxy_args=("--proxy-server=http://${auth}${PROXY_SERVER}:${PROXY_PORT}")
    fi
fi
sandbox_args=()
# Preserve the existing root-only behavior; ordinary sessions keep the sandbox.
[[ $(id -u) != 0 ]] || sandbox_args=(--no-sandbox)
profile_args=()
if ! "$explicit_profile"; then
    profile="$HOME/.config/google-chrome"
    if "$kiosk" && [[ ! -e "$profile" && -d /etc/skel/.config/google-chrome ]]; then
        mkdir -p "$HOME/.config"
        cp -a /etc/skel/.config/google-chrome "$profile" || exit 1
    fi
    profile_args=("--user-data-dir=$profile")
fi
exec /opt/google/chrome/google-chrome "${sandbox_args[@]}" "${proxy_args[@]}" "${keyring_args[@]}" --simulate-outdated-no-au='Tue, 31 Dec 2099 23:59:59 GMT' "${profile_args[@]}" "$@"
