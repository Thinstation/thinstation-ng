#!/usr/bin/python3
"""Execute one validated persistent environment job."""
import sys
from pathlib import Path
from mcp_environment_actions import run_job

if __name__ == '__main__':
    sys.exit(run_job(sys.argv[1], Path('/var/prstnt/mcp-appliance/chroots'),
                     Path('/var/prstnt/mcp-appliance/state/environments'),
                     Path('/var/prstnt/mcp-appliance/config/environment-manifests'))
             if len(sys.argv) == 2 else 2)
