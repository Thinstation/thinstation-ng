                p=subprocess.run(['/usr/bin/mcp-vault-core','revoke-grant',gid],text=True,capture_output=True)
                self.js(200 if p.returncode==0 else 400,{'ok':p.returncode==0,'vault':vault_status()}); return
            except Exception as e: self.js(400,{'ok':False,'error':str(e)}); return
        if path=='/api/vault/unlock':
            try:
                body=json.loads(self.body() or '{}'); secs=str(int(body.get('seconds',600))); scopes=[str(x) for x in body.get('scopes',[]) if str(x)]
                p=subprocess.run(['/usr/bin/mcp-vault-core','unlock',secs,*scopes],text=True,capture_output=True); self.js(200 if p.returncode==0 else 400,{'ok':p.returncode==0,'vault':vault_status(),'message':(p.stdout+p.stderr).strip()}); return
            except Exception as e: self.js(400,{'ok':False,'error':str(e)}); return
        if path=='/api/vault/lock':
            p=subprocess.run(['/usr/bin/mcp-vault-core','lock'],text=True,capture_output=True); self.js(200 if p.returncode==0 else 400,{'ok':p.returncode==0,'vault':vault_status()}); return
        if path=='/api/mail/test':
            p=subprocess.run(['/usr/bin/mcp-mail','MCP appliance test message'],input='Outbound mail from the ThinStation MCP appliance is working.\n',text=True,capture_output=True); self.js(200 if p.returncode==0 else 400,{'ok':p.returncode==0,'message':(p.stdout+p.stderr).strip()}); return
        self.js(404,{'error':'not found'})
def main():
    srv=ThreadingHTTPServer(('0.0.0.0',8443),H)
    ctx=ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    ctx.load_cert_chain(str(BASE/'identity/web.crt'),str(BASE/'identity/web.key'))
    srv.socket=ctx.wrap_socket(srv.socket,server_side=True)
    srv.serve_forever()

if __name__=='__main__':
    main()
