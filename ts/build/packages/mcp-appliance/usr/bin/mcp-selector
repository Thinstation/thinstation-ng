#!/usr/bin/python3
import hashlib, json, os, shlex, subprocess, sys
from pathlib import Path

BASE=Path('/var/prstnt/mcp-appliance')
MCP=BASE/'mcp'
RUN=Path('/run/mcp-appliance')
STATE=BASE/'state/mcp-selection.json'
FAILED=BASE/'state/mcp-failed-generations.json'
RUN.mkdir(parents=True, exist_ok=True)


def record(obj):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(obj, indent=2, sort_keys=True)+'\n')


def resolve_slot(name):
    p=MCP/name
    try:
        target=p.resolve(strict=True)
    except (FileNotFoundError, RuntimeError):
        return None
    try:
        target.relative_to(MCP/'generations')
    except ValueError:
        return None
    return target


def validate_generation(path):
    manifest=path/'manifest.json'
    if not manifest.is_file(): return False, 'manifest missing', None
    try: data=json.loads(manifest.read_text())
    except Exception as e: return False, f'manifest invalid: {e}', None
    command=data.get('command','').strip()
    if not command: return False, 'command missing', None
    argv=shlex.split(command)
    exe=Path(argv[0])
    if not exe.is_absolute(): exe=path/exe
    if not exe.is_file() or not os.access(exe, os.X_OK): return False, f'executable missing: {exe}', None
    for rel, expected in data.get('sha256',{}).items():
        f=path/rel
        if not f.is_file(): return False, f'hash target missing: {rel}', None
        h=hashlib.sha256(f.read_bytes()).hexdigest()
        if h.lower()!=str(expected).lower(): return False, f'hash mismatch: {rel}', None
    test=data.get('self_test','').strip()
    if test:
        p=subprocess.run(test, shell=True, cwd=path, timeout=20)
        if p.returncode: return False, f'self-test rc={p.returncode}', None
    workdir=data.get('working_directory','.')
    wd=(path/workdir).resolve() if not Path(workdir).is_absolute() else Path(workdir)
    resolved_command=shlex.join([str(exe), *argv[1:]])
    return True, 'ok', {'kind':'persistent','generation':path.name,'command':resolved_command,'working_directory':str(wd)}

try:
    failed=set(json.loads(FAILED.read_text()).get('failed',[])) if FAILED.exists() else set()
except Exception:
    failed=set()

attempts=[]
for slot in ('active','previous'):
    path=resolve_slot(slot)
    if path is None:
        attempts.append({'slot':slot,'ok':False,'reason':'slot unavailable'})
        continue
    if path.name in failed:
        attempts.append({'slot':slot,'generation':path.name,'ok':False,'reason':'runtime failure quarantine'})
        continue
    ok,reason,selected=validate_generation(path)
    attempts.append({'slot':slot,'generation':path.name,'ok':ok,'reason':reason})
    if ok:
        selected['slot']=slot
        break
else:
    selected={'kind':'recovery','generation':'immutable','slot':'recovery','command':'/usr/bin/mcp-recovery','working_directory':'/var/prstnt/mcp-appliance/work'}

(RUN/'selected.json').write_text(json.dumps(selected, indent=2, sort_keys=True)+'\n')
(RUN/'runtime.env').write_text(
    f"MCP_SOURCE={selected['kind']}:{selected['slot']}:{selected['generation']}\n"
    f"MCP_COMMAND={selected['command']}\n"
    f"MCP_WORKDIR={selected['working_directory']}\n"
)
record({'selected':selected,'attempts':attempts})
print(json.dumps(selected))
