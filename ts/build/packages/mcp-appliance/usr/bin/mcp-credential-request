#!/usr/bin/python3
import json, os, secrets, sys, tempfile, time
from pathlib import Path

BASE=Path('/var/prstnt/mcp-appliance')
PATH=BASE/'state/credential-requests.json'

def load():
    try:
        d=json.loads(PATH.read_text())
        return d.get('requests',[]) if isinstance(d,dict) else []
    except Exception:
        return []

def save(rows):
    PATH.parent.mkdir(parents=True,exist_ok=True)
    fd,tmp=tempfile.mkstemp(prefix='.credential-requests.',dir=str(PATH.parent))
    try:
        os.write(fd,(json.dumps({'requests':rows},indent=2)+'\n').encode())
        os.fchmod(fd,0o600); os.close(fd); os.replace(tmp,PATH)
    except Exception:
        try: os.close(fd)
        except OSError: pass
        try: os.unlink(tmp)
        except OSError: pass
        raise

def request(body):
    project=str(body.get('project','')).strip()
    name=str(body.get('name','')).strip()
    ctype=str(body.get('type','secret')).strip() or 'secret'
    purpose=str(body.get('purpose','')).strip()
    instructions=str(body.get('instructions','')).strip()
    scopes=[str(x).strip() for x in body.get('scopes',[]) if str(x).strip()]
    hosts=[str(x).strip().lower().rstrip('.') for x in body.get('hosts',[]) if str(x).strip()]
    if not project or not name: raise ValueError('project and credential name are required')
    if len(project)>120 or len(name)>120 or len(ctype)>80 or len(purpose)>200 or len(instructions)>2000: raise ValueError('credential request field too long')
    if not all(c.isalnum() or c in '._-:@/' for c in name): raise ValueError('invalid credential name')
    rid=str(body.get('id','')).strip() or secrets.token_hex(8)
    rows=[r for r in load() if isinstance(r,dict) and r.get('id')!=rid]
    row={'id':rid,'project':project,'name':name,'type':ctype,'purpose':purpose,'scopes':scopes,'hosts':hosts,'instructions':instructions,'created':int(time.time())}
    rows.append(row); save(rows); return row

def main():
    cmd=sys.argv[1] if len(sys.argv)>1 else 'request'
    if cmd=='list':
        print(json.dumps({'requests':load()},indent=2)); return
    if cmd=='dismiss':
        if len(sys.argv)!=3: raise SystemExit('usage: mcp-credential-request dismiss ID')
        rid=sys.argv[2]; save([r for r in load() if not isinstance(r,dict) or r.get('id')!=rid]); print(json.dumps({'ok':True,'id':rid})); return
    if cmd!='request': raise SystemExit('usage: mcp-credential-request [request|list|dismiss ID]')
    body=json.load(sys.stdin); print(json.dumps(request(body),indent=2))

if __name__=='__main__': main()
