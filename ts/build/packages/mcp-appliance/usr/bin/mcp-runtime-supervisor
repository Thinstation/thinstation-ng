#!/usr/bin/python3
"""Supervise one selected runtime; scope immutable failures to the current boot."""
import os
from pathlib import Path
import shlex
import signal
import subprocess
import time
from mcp_runtime import BASE, RUN, Selector, read_json

child = None
stopping = False


def stop(*_):
    global stopping
    stopping = True
    if child is not None and child.poll() is None:
        child.terminate()


def state(message):
    target = BASE / 'state/mcp-runtime.state'
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(message + '\n')
    print(message, flush=True)


def main():
    global child
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    selector = Selector()
    failures, previous_key = 0, None
    while not stopping:
        selected = read_json(RUN / 'selected.json', {}) or selector.apply()
        key = (selected['kind'], selected['generation'], selected.get('archive_sha256'))
        if key != previous_key:
            failures = 0
            previous_key = key
        source = '{kind}:{slot}:{generation}'.format(**selected)
        work = Path(selected['working_directory'])
        work.mkdir(parents=True, exist_ok=True)
        env = os.environ.copy()
        env.setdefault('MCP_AUDIT_LOG', str(BASE / 'log/command-audit.log'))
        env.setdefault('MCP_WORKSPACE_ROOT', str(BASE))
        env['PYTHONDONTWRITEBYTECODE'] = '1'
        (BASE / 'log').mkdir(parents=True, exist_ok=True)
        started = time.monotonic()
        state('starting source=' + source)
        try:
            child = subprocess.Popen(shlex.split(selected['command']), cwd=work, env=env)
            state('running source=' + source + ' pid=' + str(child.pid))
            rc = child.wait()
        except OSError as exc:
            state('spawn failed source=' + source + ': ' + str(exc))
            rc = 127
        if stopping:
            break
        runtime = time.monotonic() - started
        failures = 0 if runtime >= 30 else failures + 1
        state(f'exited source={source} rc={rc} runtime={runtime:.1f}s failures={failures}')
        if selected['kind'] in ('persistent', 'bundled') and failures >= 3:
            selector.quarantine(selected, f'rc={rc}; three rapid failures')
            state('quarantined source=' + source + '; selecting fallback')
            try:
                subprocess.run(['/usr/bin/mcp-alert', 'critical', 'MCP runtime fallback'],
                               input='Runtime ' + source + ' failed repeatedly; selecting fallback.\n',
                               text=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
            except (OSError, subprocess.SubprocessError):
                pass
            selector.apply()
            failures = 0
        time.sleep(2)
    state('stopped')


if __name__ == '__main__':
    main()
