#!/bin/sh
set -eu
export PACKAGE=mcp-appliance
export PORTS="" RPM="" DROP_FILES="" DROP_DIRS="" CREATE_EMPTY_DIRS=""
package_root="${TSWRKNG}/packages/$PACKAGE"
if [ -n "${XTRWRKNG:-}" ] && [ -d "$XTRWRKNG/packages/$PACKAGE" ]; then
    package_root="$XTRWRKNG/packages/$PACKAGE"
fi
# Use the existing repackage recipe lifecycle and installed-marker contract.
# The payload itself is a pinned Python application archive, not another RPM.
trap 'rm -f "$package_root/build/installed"' EXIT HUP INT TERM
repackage -e
python3 "$package_root/build/install-bundled.py" "$package_root"
touch "$package_root/build/installed"
trap - EXIT HUP INT TERM
