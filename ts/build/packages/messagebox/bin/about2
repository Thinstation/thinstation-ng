#!/bin/bash

KEY=$RANDOM
. /etc/os-release

function show_mod_info {
  TXT="\\n<span face='Monospace'>$(modinfo $1 | sed 's/&/\&amp;/g;s/</\&lt;/g;s/>/\&gt;/g')</span>"
  yad --title="Module information" \
      --window-icon="application-x-addon" \
      --button="yad-close" \
      --width=500 \
      --image="application-x-addon" --text="$TXT"
}
export -f show_mod_info

tab_index=0
# CPU tab
if which lscpu; then
  let tab_index+=1
  cputab='--tab=CPU'
  lscpu | sed -r "s/:[ ]*/\n/" |\
    yad --plug=$KEY --tabnum=$tab_index --image=processor --text="CPU information" \
      --list --no-selection --column="Parameter" --column="Value" &
fi

# Memory tab
let tab_index+=1
memorytab='--tab=Memory'
awk '$3=="kB"{$2=$2/1024;$3="MB"} 1' /proc/meminfo | sed -r "s/:[ ]*/\n/" |\
  yad --plug=$KEY --tabnum=$tab_index --image=memory \
      --text="Memory usage information" \
      --list --no-selection --column="Parameter" --column="Value" &

# Harddrive tab
let tab_index+=1
storagetab='--tab=Storage'
df -T | tail -n +2 | awk '{printf "%s\n%s\n%s\n%s\n%s\n%s\n", $1,$7, $2, $3, $4, $6}' |\
  yad --plug=$KEY --tabnum=$tab_index --image=drive-harddisk \
      --text="Disk space usage" \
      --list --no-selection --column="Device" \
      --column="Mountpoint" --column="Type" \
      --column="Total:sz" --column="Free:sz" \
      --column="Usage:bar" &

# PCI tab
let tab_index+=1
pcitab='--tab=PCI'
lspci -vmm | sed 's/\&/\&amp;/g' | grep -E "^(Slot|Class|Vendor|Device):" | cut -f2 |\
  yad --plug=$KEY --tabnum=$tab_index --image pci --text="PCI bus devices" \
      --list --no-selection --column="ID" --column="Class" \
      --column="Vendor" --column="Device" &

# Modules tab
let tab_index+=1
modulestab='--tab=Modules'
awk '{printf "%s\n%s\n%s\n", $1, $3, $4}' /proc/modules | sed "s/[,-]$//" |\
  yad --plug=$KEY --tabnum=$tab_index --text="Loaded kernel modules" \
      --image="application-x-addon" --image-on-top \
      --list --dclick-action='bash -c "show_mod_info %s"' \
      --column="Name" --column="Used" --column="Depends" &

# Battery tab
if which acpi; then
  let tab_index+=1
  acpitab='--tab=Battery'
  ( acpi -i ; acpi -a ) | sed -r "s/:[ ]*/\n/" | yad --plug=$KEY --tabnum=$tab_index \
    --image=battery --text="Battery state" --list --no-selection \
    --column="Device" --column="Details" &
fi

# Sensors tab
if which sensors; then
  let tab_index+=1
  sensorstab='--tab=Sensors'
  SENSORS=($(sensors | grep -E '^[^:]+$'))
  sid=1
  cid=1

  for s in ${SENSORS[@]}; do
    echo -e "s$sid\n<b>$s</b>\n"
    sensors -A "$s" | tail -n +2 | while read ln; do
      [[ $ln == "" ]] && continue
      echo "$cid:s$sid"
      echo $ln | sed -r 's/:[ ]+/\n/'
      ((cid++))
    done
      ((sid++))
  done | yad --plug=$KEY --tabnum=$tab_index --image fan --text="Temperature sensors information" \
    --list --tree --tree-expanded --no-selection --column="Sensor" --column="Value" &
fi

# Network Dialog
let tab_index+=1
networktab='--tab=Network'
HOSTNAME=$(hostname -s)
FQDN=$(hostname -f)
IP=$(ip route get 1.1.1.1 |awk '{print $7;exit}')
CIDR=$(ip addr show |grep -o $IP/[0-9][0-9] | cut -d '/' -f2)
GATEWAY=$(ip route get 1.1.1.1 |awk '{print $3;exit}')
DEVICE=$(ip route get 1.1.1.1 |awk '{print $5;exit}')
DNS=$(resolvectl dns |grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' |head -n1)
(echo -e "Hostname\n$HOSTNAME\n" "FQDN\n$FQDN\n" "Device\n$DEVICE\n" "IP Adress\n$IP\n" "CIDR Bits\n$CIDR\n" "Gateway\n$GATEWAY\n" "DNS\n$DNS" ) |\
  yad --plug=$KEY --tabnum=$tab_index --image=network-connections --text="Network information" \
    --list --no-selection --column="Parameter" --column="Value" &

# Main dialog
TXT="<b>Hardware system information</b>\\n\\n"
TXT+="\\tOS: $PRETTY_NAME on $(hostname)\\n"
TXT+="\\tKernel: $(uname -sr)\\n\\n"
TXT+="\\tUptime: <i>$(uptime)</i>"

yad --notebook --window-icon="dialog-information" \
    --width=680 --height=483 --title="System info" --text="$TXT" --button=yad-close \
    --key=$KEY $cputab $memorytab $storagetab $pcitab $modulestab $acpitab $sensorstab $networktab --active-tab=${1:-1}
