#!/bin/sh
#repackage

mkdir -p ./packages/alltimezone/usr/share \
	&& mkdir -p ./packages/alltimezone/usr/share/xml/iso-codes \
	&& cp -a /usr/share/zoneinfo ./packages/alltimezone/usr/share/. \
	&& cp -a /usr/share/xml/iso-codes/* ./packages/alltimezone/usr/share/xml/iso-codes/. \
	&& touch ./packages/alltimezone/build/installed

returnval=$?

exit $returnval
