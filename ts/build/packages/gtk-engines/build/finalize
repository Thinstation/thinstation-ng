#gtk-engines 42
if [ "$GTK_THEME" != "ALL" ]; then
	if [ -z "$GTK_THEME" ]; then
		GTK_THEME=Adwaita
	fi
	if [ -e /usr/share/themes/$GTK_THEME/gtk-2.0/gtkrc ]; then
		engine="`grep /usr/share/themes/$GTK_THEME/gtk-2.0/gtkrc -e engine |grep -v "#" |grep -v pixmap|tail -n1 |cut -d '"' -f2`"
		if [ -z "$engine" ] && [ -e /usr/share/themes/$GTK_THEME/gtk-2.0/gtk.css ]; then
			engine="`grep /usr/share/themes/$GTK_THEME/gtk-2.0/gtk.css -e engine |cut -d: -f3 |cut -d ';' -f1`"
		fi
		if [ -z $engine ] && [ -e /usr/share/themes/$GTK_THEME/gtk-2.0/main.rc ]; then
			engine="`grep /usr/share/themes/$GTK_THEME/gtk-2.0/main.rc -e engine |grep -v "#" |grep -v pixmap|tail -n1 |cut -d '"' -f2`"
		fi
		for del_engine in `find /lib/gtk-2.0/2.10.0/engines -type f |grep -v pixmap |grep -v $engine`; do
			rm $del_engine
		done
		sed -i -e "s/gtk-theme-name = \"Adwaita\"/gtk-theme-name = \"$GTK_THEME\"/g" /etc/gtk-2.0/gtkr*
	elif [ -e /etc/gtk-2.0 ]; then
		echo -e "\tGtk-2 Theme $GTK_THEME not found!"
	fi
	mkdir -p /etc/gtk-3.0
	if [ ! -e /etc/gtk-3.0/settings.ini ]; then
		echo "[Settings]" >> /etc/gtk-3.0/settings.ini
	fi
	if [ -e /usr/share/themes/$GTK_THEME/gtk-3.0/gtk.css ]; then
		echo "gtk-theme-name = $GTK_THEME" >> /etc/gtk-3.0/settings.ini
	elif [ -e /etc/gtk-3.0 ]; then
		echo -e "\tGtk-3 Theme $GTK_THEME not found!"
	fi
	for theme in `find /usr/share/themes -name gtkrc -o -name gtk.css |cut -d "/" -f5`; do
		if [ "$theme" != "$GTK_THEME" ]; then
			rm -rf /usr/share/themes/$theme/gtk-2.0
			rm -rf /usr/share/themes/$theme/gtk-3.0
			if [ -d /usr/share/themes/$theme ] && [ -z "`ls -A /usr/share/themes/$theme`" ]; then
				rmdir /usr/share/themes/$theme
			fi
		fi
	done
fi
