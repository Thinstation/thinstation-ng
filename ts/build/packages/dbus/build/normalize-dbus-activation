#!/bin/bash
# Run on an assembled image, not individual RPMs or live user sessions.
# Only rename vendor activation records; never edit contents or pick a provider.
set -euo pipefail
export LC_ALL=C

dry_run=false
if [ "${1:-}" = --dry-run ]; then dry_run=true; shift; fi
if [ "$#" -ne 1 ] || [ ! -d "$1" ]; then
    echo "Usage: $0 [--dry-run] IMAGE_ROOT" >&2
    exit 2
fi
root=$(cd -- "$1" && pwd -P)
root=${root%/}
shopt -s nullglob dotglob
renamed=0
skipped=0
unchanged=0

warn()
{
    printf 'D-Bus activation: WARNING: %s\n' "$*" >&2
}

# Do not traverse a package-supplied directory symlink against the build host.
# Return 2 for an absent directory; 1 for an opaque/non-directory component.
plain_directory()
{
    local relative=$1 part path=$root
    local -a parts
    IFS=/ read -r -a parts <<< "$relative"
    for part in "${parts[@]}"; do
        path="$path/$part"
        [ ! -L "$path" ] || return 1
        [ -e "$path" ] || return 2
        [ -d "$path" ] || return 1
    done
}

# Inspect leaf symlinks within IMAGE_ROOT without following host paths. Keep
# directory symlinks opaque, and reject cycles, missing targets and root escapes.
resolve_activation_link()
{
    local part path target hops=0
    local -a pending=() parents=()
    IFS=/ read -r -a pending <<< "${1#"$root"/}"
    while [ "${#pending[@]}" -gt 0 ]; do
        part=${pending[0]}
        pending=("${pending[@]:1}")
        case "$part" in
            ''|.) continue ;;
            ..)
                [ "${#parents[@]}" -gt 0 ] || return 1
                unset 'parents[-1]'
                continue
                ;;
        esac
        path=$root
        for target in "${parents[@]}"; do path="$path/$target"; done
        path="$path/$part"
        if [ -L "$path" ]; then
            [ "${#pending[@]}" -eq 0 ] || return 1
            hops=$((hops + 1))
            [ "$hops" -le 40 ] || return 1
            target=$(readlink "$path") || return 1
            case "$target" in *$'\n'*) return 1 ;; esac
            case "$target" in /*) parents=() ;; esac
            IFS=/ read -r -a pending <<< "$target"
        elif [ "${#pending[@]}" -gt 0 ]; then
            [ -d "$path" ] || return 1
            parents+=("$part")
        else
            [ -f "$path" ] && [ -r "$path" ] || return 1
            printf '%s\n' "$path"
            return 0
        fi
    done
    return 1
}

read_name()
{
    awk '
        { sub(/\r$/, ""); line=$0; sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line) }
        line == "" || line ~ /^[#;]/ { next }
        line ~ /^\[/ { in_service=(line == "[D-BUS Service]"); sections+=in_service; next }
        in_service && line ~ /^Name[ \t]*=/ {
            sub(/^Name[ \t]*=[ \t]*/, "", line)
            name=line; count++
        }
        END {
            if (sections != 1 || count != 1 || name == "") exit 1
            print name
        }
    ' "$1"
}

for bus in session system; do
    # Other image-wide locations participate in collision detection only.
    # Runtime XDG paths/custom servicedir settings are not rewritten here.
    if [ "$bus" = session ]; then
        vendor=usr/share/dbus-1/services
        directories=("$vendor" usr/local/share/dbus-1/services)
    else
        vendor=usr/share/dbus-1/system-services
        directories=("$vendor" usr/local/share/dbus-1/system-services
                     etc/dbus-1/system-services run/dbus-1/system-services)
    fi
    declare -A names=() counts=() providers=() occupied=()
    candidates=()
    scanned=()
    opaque=false
    for relative in "${directories[@]}"; do
        if plain_directory "$relative"; then
            scanned+=("$root/$relative")
        else
            status=$?
            if [ "$status" -ne 2 ]; then
                warn "$bus: cannot safely inspect /$relative; leaving this bus unchanged"
                opaque=true
            fi
            continue
        fi
        for file in "$root/$relative"/*.service; do
            occupied["$file"]=1
            # Canonical in-image aliases (notably systemd's session record)
            # count as providers but are never renamed. Their target must also
            # be canonical, so normalization cannot invalidate the link.
            record=$file
            if [ -L "$file" ]; then
                if ! record=$(resolve_activation_link "$file"); then
                    warn "$bus: unresolved activation link ${file#"$root"}; leaving this bus unchanged"
                    opaque=true
                    continue
                fi
            elif [ ! -f "$file" ]; then
                warn "$bus: non-regular activation entry ${file#"$root"}; leaving this bus unchanged"
                opaque=true
                continue
            fi
            if ! name=$(read_name "$record"); then
                warn "$bus: ambiguous/missing Name in ${file#"$root"}; leaving this bus unchanged"
                opaque=true
                continue
            fi
            if [ "${#name}" -gt 247 ] ||
               [[ ! "$name" =~ ^[A-Za-z_-][A-Za-z0-9_-]*(\.[A-Za-z_-][A-Za-z0-9_-]*)+$ ]]; then
                warn "$bus: invalid or overlong bus Name in ${file#"$root"}; leaving this bus unchanged"
                opaque=true
                continue
            fi
            if [ -L "$file" ] && { [ "${file##*/}" != "$name.service" ] ||
                                      [ "${record##*/}" != "$name.service" ]; }; then
                warn "$bus: noncanonical activation link ${file#"$root"}; leaving this bus unchanged"
                opaque=true
                continue
            fi
            names["$file"]=$name
            counts["$name"]=$(( ${counts["$name"]:-0} + 1 ))
            providers["$name"]="${providers["$name"]:-} ${file#"$root"}"
            [ "$relative" != "$vendor" ] || candidates+=("$file")
        done
    done
    for file in "${candidates[@]}"; do
        name=${names["$file"]}
        canonical="$name.service"
        if [ "${file##*/}" = "$canonical" ]; then
            unchanged=$((unchanged + 1))
            continue
        fi
        reason=''
        if "$opaque"; then
            reason='incomplete provider inventory'
        elif [ "${counts["$name"]}" -ne 1 ]; then
            reason="multiple providers for $name:${providers["$name"]}"
        else
            for directory in "${scanned[@]}"; do
                if [ "${occupied["$directory/$canonical"]:-0}" = 1 ] ||
                   [ -e "$directory/$canonical" ] || [ -L "$directory/$canonical" ]; then
                    reason="preferred filename occupied: ${directory#"$root"}/$canonical"
                    break
                fi
            done
        fi
        if [ -n "$reason" ]; then
            warn "$bus: keep ${file#"$root"}: $reason"
            skipped=$((skipped + 1))
            continue
        fi
        dest="${file%/*}/$canonical"
        if "$dry_run"; then
            printf 'D-Bus activation: WOULD RENAME %s -> %s\n' "${file#"$root"}" "${dest#"$root"}"
        else
            # -n forbids replacement; -T forbids interpreting DEST as a folder.
            # A concurrent destination creation therefore cannot be overwritten.
            mv -nT -- "$file" "$dest"
            if [ -e "$file" ] || [ -L "$file" ]; then
                warn "$bus: keep ${file#"$root"}: destination appeared before rename"
                skipped=$((skipped + 1))
                continue
            fi
            printf 'D-Bus activation: RENAMED %s -> %s\n' "${file#"$root"}" "${dest#"$root"}"
        fi
        renamed=$((renamed + 1))
    done
done
printf 'D-Bus activation: renamed=%s skipped=%s already-canonical=%s dry-run=%s\n' \
    "$renamed" "$skipped" "$unchanged" "$dry_run"
