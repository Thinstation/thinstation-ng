#! /bin/sh

. `dirname $0`/common

#set -x
#exec </dev/null >/var/log/console-keymap.log  2>&1

        if [ -d /usr/share/locale ] ; then
		if [ -z "$LOCALE" ] || [ -n "$LOCALE" ] && [ ! -e /usr/share/locale/${LOCALE}_locale ]; then
		LOCALE=`find /usr/share/locale -mindepth 1 -maxdepth 1|grep -e _locale |tail -n 1`
		elif [ -e /usr/share/locale/${LOCALE}_locale ]; then
			LOCALE=/usr/share/locale/${LOCALE}_locale
		fi
        fi
        if [ -e $LOCALE ] && [ "$LOCALE" != "" ]; then
		if [ -n "$DEBUG_BOOT" ]; then
	                echo "Extended locale support enabled" >> $LOGFILE
		fi
                cat $LOCALE >> $TS_RUNTIME
		. $LOCALE
		echo "LANG=$LANG" > /etc/locale.conf
        else
		echo_log "\nNotice!, no locale found. You should really choose a locale in build.conf even if you are in the US"
		echo_log "Continuing boot with default C locale"
        fi
	if [ -e /usr/lib64/kbd/keymaps/$CONSOLE_KEYBOARD ] && [ "$CONSOLE_KEYBOARD" != "" ] ; then
#		loadkeys /usr/lib64/kbd/keymaps/$CONSOLE_KEYBOARD
		echo "KEYMAP=\"`basename $CONSOLE_KEYBOARD .map.gz`\"" > /etc/vconsole.conf
	else
		echo_log "\nNotice!, no keymap found"
		echo_log "Continuing boot with default BIOS keymap"
	fi
        if [ -e /usr/lib64/kbd/consolefonts/$CONSOLE_FONT ] && [ "$CONSOLE_FONT" != "" ] ; then
#                setfont /usr/lib64/kbd/consolefonts/$CONSOLE_FONT
		echo "FONT=\"`basename $CONSOLE_FONT .psfu.gz`\"" >> /etc/vconsole.conf
		if [ -n "$DEBUG_BOOT" ]; then
	                echo "Loading console font: $CONSOLE_FONT" >> $LOGFILE
		fi
        else
                echo_log "\nNotice!, no console font found"
                echo_log "Continuing boot with default kernel font"
        fi
	if [ "`readlink /etc/localtime`" != "/usr/share/zoneinfo/$TIME_ZONE" ] ; then
		rm /etc/localtime
		ln -sf /usr/share/zoneinfo/$TIME_ZONE /etc/localtime
	fi
