#!/bin/sh

export PACKAGE=systemd
export PORTS="systemd systemd-sysusers systemd-libs systemd-pam systemd-resolved systemd-udev wireless-regdb"
export DROP_FILES="	etc.conf \
			systemd-growfs \
			systemd-makefs \
			systemd-fsck \
			shutdown \
			ldconfig.service \
			installkernel \
			kernel-install \
			issue \
			init"

export DROP_DIRS="	etc/kernel \
			lib64/dnf5 \
			lib64/kernel "

repackage -e
returnval=$?

mkdir -p ./packages/$PACKAGE/sbin
for i in runlevel reboot poweroff halt telinit; do
	ln -sf /bin/systemctl ./packages/$PACKAGE/bin/$i
	let returnval=returnval+$?
done
#for link in init sbin/init ; do
#	ln -sf /usr/lib64/systemd/systemd ./packages/$PACKAGE/$link
#	let returnval=returnval+$?
#done

ln -sf libudev.so.1 ./packages/$PACKAGE/lib64/libudev.so.0

exit $returnval
