#systemd 30

systemctl enable systemd-vconsole-setup-reload.service

if [ ! -e /etc/init.d/ntpconf ] && [ ! -e /etc/init.d/ntpdate ]; then
	if [ -n "$NET_TIME_SERVER" ]; then
		echo "NTP=$NET_TIME_SERVER" >> /etc/systemd/timesyncd.conf
		systemctl enable systemd-timesyncd
	fi
	if [ -n "$NET_TIME_SERVER_BACKUP" ]; then
		echo "FallbackNTP=$NET_TIME_SERVER_BACKUP" >> /etc/systemd/timesyncd.conf
	fi
fi

systemctl enable systemd-resolved
rm /lib64/systemd/system/sysinit.target.wants/systemd-update-done.service

# Specify the alternate passwd and group files
ALTERNATE_PASSWD="/build/passwd"
ALTERNATE_GROUP="/build/group"

# Cache valid IDs and build-time fallback mappings once. The old implementation
# spawned stat/getent/awk shells for every path in the image, which became very
# expensive as the image grew.
declare -A valid_uids valid_gids alternate_users alternate_groups

while IFS=: read -r name _ uid _; do
    [ -n "$uid" ] && valid_uids["$uid"]=1
done < <(getent passwd)

while IFS=: read -r name _ gid _; do
    [ -n "$gid" ] && valid_gids["$gid"]=1
done < <(getent group)

while IFS=: read -r name _ uid _; do
    [ -n "$uid" ] && alternate_users["$uid"]="$name"
done < "$ALTERNATE_PASSWD"

while IFS=: read -r name _ gid _; do
    [ -n "$gid" ] && alternate_groups["$gid"]="$name"
done < "$ALTERNATE_GROUP"

echo "Normalizing file/dir user and group ID's"

# find can report numeric UID/GID itself, avoiding a stat subprocess per path.
# Keep NUL delimiters so unusual filenames remain safe.
while IFS= read -r -d '' user_id &&
      IFS= read -r -d '' group_id &&
      IFS= read -r -d '' file; do
    target_user=""
    target_group=""

    if [ -z "${valid_uids[$user_id]+x}" ]; then
        target_user="${alternate_users[$user_id]}"
        if [ -z "$target_user" ]; then
            echo "Invalid user ID $user_id for file $file"
        fi
    fi

    if [ -z "${valid_gids[$group_id]+x}" ]; then
        target_group="${alternate_groups[$group_id]}"
        if [ -z "$target_group" ]; then
            echo "Invalid group ID $group_id for file $file"
        fi
    fi

    if [ -n "$target_user" ] || [ -n "$target_group" ]; then
        # chown/chgrp clear file capabilities and can clear setuid/setgid bits.
        # Preserve both around the complete ownership update.
        mode=$(stat -c '%a' "$file")
        caps=$(getcap "$file" | cut -d' ' -f2)

        if [ -n "$target_user" ] && [ -n "$target_group" ]; then
            chown "$target_user:$target_group" "$file"
        elif [ -n "$target_user" ]; then
            chown "$target_user" "$file"
        else
            chgrp "$target_group" "$file"
        fi

        chmod "$mode" "$file"
        if [ -n "$caps" ]; then
            setcap "$caps" "$file"
        fi
    fi
done < <(find / \( -path /proc -o -path /sys -o -path /dev \) -prune -o -printf '%U\0%G\0%p\0')

/usr/lib/systemd/systemd-update-helper install-system-units systemd-udev{d,-settle,-trigger}.service systemd-udevd-{control,kernel}.socket systemd-homed.service systemd-oomd.service systemd-pstore.service
