# Audit Docker/container runtime control-plane configuration.
-w /etc/docker/ -p wa -k docker_config
-w /etc/containerd/ -p wa -k containerd_config

# Audit interactive/user execution of the Docker CLI without tracing daemon internals.
-a always,exit -F arch=b64 -F path=/usr/bin/docker -F perm=x -F auid>=1000 -F auid!=unset -k docker_cli
-a always,exit -F arch=b32 -F path=/usr/bin/docker -F perm=x -F auid>=1000 -F auid!=unset -k docker_cli
