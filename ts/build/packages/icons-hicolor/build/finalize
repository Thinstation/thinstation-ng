#icons-hicolor 43

if [ -n "$ICONS_THEME" ]; then
	:
elif [ -e /usr/share/icons/Adwaita ]; then
	ICONS_THEME=/Adwaita
elif [ -e /usr/share/icons/gnome ]; then
	ICONS_THEME=gnome
else 
	ICONS_THEME=hicolor
fi

if [ -e /etc/gtk-2.0/gtkrc ]; then
	sed -i -e "s/gtk-icon-theme-name = \"gnome\"/gtk-icon-theme-name = \"$ICONS_THEME\"/g" /etc/gtk-2.0/gtkrc
fi

if [ ! -e /etc/gtk-3.0/settings.ini ]; then
	mkdir -p /etc/gtk-3.0
	echo "[Settings]" >> /etc/gtk-3.0/settings.ini
fi
echo "gtk-icon-theme-name = $ICONS_THEME" >> /etc/gtk-3.0/settings.ini

if [ -n "$ICONS_CUT_SIZES" ]; then
	for size in $ICONS_CUT_SIZES; do
		for theme in `ls /usr/share/icons`; do
			if [ -e /usr/share/icons/$theme/$size ]; then
				rm -rf /usr/share/icons/$theme/$size
			fi
		done
	done
fi

echo -e "\tCaching icons"
for icontheme in `ls --color=never /usr/share/icons`; do
	if [ -d /usr/share/icons/$icontheme ]; then
		rm -f /usr/share/icons/$icontheme/icon-theme.cache
		/bin/gtk-update-icon-cache -i /usr/share/icons/$icontheme 2>/dev/null
	fi
done
rm /usr/bin/gtk-update-icon-cache
