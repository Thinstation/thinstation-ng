SESSION_0_TYPE=sh
SESSION_0_AUTOSTART=off
NET_USE=BOTH
NET_USE_DHCP=on
NET_HOSTNAME=mcp-*
NET_FILE_ENABLED=Off
NET_TELNETD_ENABLED=Off
NET_REMOTE_ACCESS_FROM="0.0.0.0"
MOUNT_0="LABEL=prstnt /var/prstnt auto X-mount.mkdir,nofail,x-systemd.device-timeout=5s 0 0"
MOUNT_1="filedrop-nfs.thinstation.org:/mnt/pve/cephfs/filedrop-nfs /mnt/filedrop nfs4 X-mount.mkdir,_netdev,nofail,x-systemd.automount,vers=4.2,proto=tcp 0 0"
TIME_ZONE=UTC

# MCP persistent-generation bootstrap policy.
# Installation is explicit by default. Recovery remains immutable fallback.
# off: stay on recovery until an administrator installs/activates an MCP.
# channel/recovery remain available for site-specific unattended bootstrap.
MCP_BOOTSTRAP_MODE=off
MCP_BOOTSTRAP_GENERATION=bootstrap
MCP_CHANNEL_URL=https://distro.thinstation.org/files/thinstation-mcp/mcp/catalog.json

# Fedora/DNF release used by appliance package tooling.
DIST_VER=44
DNF_VAR_releasever=44

# Optional Foreman Fedora repository URLs for MCP chroot packages.
# Leave empty for upstream; configure site-specific URLs at build time.
MCP_PACKAGE_FEDORA_URL=""
MCP_PACKAGE_UPDATES_URL=""
