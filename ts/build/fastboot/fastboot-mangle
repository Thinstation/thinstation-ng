#!/bin/bash
# Fastboot by Donald A. Cupp Jr. don cupp jr at yahoo dot com
#
# The package/build format remains ThinStation's historical merged-root layout.
# make_initrd() converts the completed tree to usr-merge before this script runs.
#
# Split /usr into an early initrd half and a deferred lib.squash half.
#   FASTBOOT=true      -> early files live under /fastboot and mounted /usr
#                         contains links back to them.
#   FASTBOOT=lotsofmem -> deferred files are unpacked over /; no early payload
#                         file is also present in lib.squash.

LANG=C

INITDIR=$1
FASTBOOT_MODE=$2
HARDLINK=$3
FB_COMP_EXTRA=$4

FASTBOOT_DIR=../fastboot
DEFERRED_DIR=../fastboot-tmp
WORK_DIR=${TMPDIR:-/tmp}/thinstation-fastboot.$$

USR_DIR=usr
BIN_DIR=$USR_DIR/bin
SBIN_DIR=$USR_DIR/sbin
LIB_DIR=$USR_DIR/lib
LIB64_DIR=$USR_DIR/lib64
SHARE_DIR=$USR_DIR/share

FASTLIB_NEED=$WORK_DIR/fastlibneed
FASTLIB_KEEP=$WORK_DIR/fastlib.keep
FASTLIB_PREVIOUS=$WORK_DIR/fastlib.previous
FASTLIB_NEW=$WORK_DIR/fastlib.new
FASTLIB_ROOTS=$WORK_DIR/fastlib.roots

mkdir -p "$WORK_DIR"
trap 'rm -rf "$WORK_DIR"' EXIT

echo "FASTBOOT=$FASTBOOT_MODE" >> etc/thinstation.env
mkdir -p "$BIN_DIR" "$SBIN_DIR" "$LIB_DIR" "$LIB64_DIR" "$SHARE_DIR"
cp --remove-destination /bin/mount "$BIN_DIR/."

read_list()
{
	local file=$1
	[ -f "$file" ] || return 0
	grep -Ev '^[[:space:]]*(#|$)' "$file"
}

is_listed()
{
	local value=$1
	local file=$2
	grep -Fxq "$value" "$file" 2>/dev/null
}

record_ldd()
{
	local file=$1
	[ -e "$file" ] || return 0
	ldd "$file" 2>/dev/null >> "$FASTLIB_NEED" || true
}

parse_ldd_names()
{
	local file=$1
	[ -s "$file" ] || return 0

	awk '
		/not a dynamic executable/ { next }
		/statically linked/ { next }
		/^[[:space:]]*linux-vdso\.so/ { next }
		{
			gsub(/^[[:space:]]+/, "", $0)
			name=$1
			if (name ~ /^\//) {
				n=split(name, parts, "/")
				name=parts[n]
			}
			if (name != "" && name !~ /:$/)
				print name
		}
	' "$file" | sort -u
}

target_library()
{
	local lib=$1

	for dir in "$LIB64_DIR" "$LIB_DIR"; do
		if [ -e "$dir/$lib" ]; then
			printf '%s\n' "$dir/$lib"
			return 0
		fi
	done
	return 1
}

find_library_source()
{
	local lib=$1
	local target

	target=$(target_library "$lib") && {
		printf '%s\n' "$target"
		return 0
	}

	for dir in /usr/lib64 /usr/lib /lib64 /lib; do
		if [ -e "$dir/$lib" ]; then
			printf '%s\n' "$dir/$lib"
			return 0
		fi
	done

	find /usr/lib64 /usr/lib /lib64 /lib -name "$lib" -print -quit 2>/dev/null
}

seed_retained_libraries()
{
	: > "$FASTLIB_ROOTS"

	while IFS= read -r lib; do
		[ -n "$lib" ] || continue
		target_library "$lib" >/dev/null && printf '%s\n' "$lib" >> "$FASTLIB_ROOTS"
	done < <(read_list "$FASTBOOT_DIR/lib-boot")

	parse_ldd_names "$FASTLIB_NEED" >> "$FASTLIB_ROOTS"
	sort -u -o "$FASTLIB_ROOTS" "$FASTLIB_ROOTS"
}

expand_retained_library_dependencies()
{
	local lib source

	seed_retained_libraries
	cp "$FASTLIB_ROOTS" "$FASTLIB_KEEP"

	while : ; do
		cp "$FASTLIB_KEEP" "$FASTLIB_PREVIOUS"
		: > "$FASTLIB_NEED"

		while IFS= read -r lib; do
			[ -n "$lib" ] || continue
			source=$(target_library "$lib") || source=$(find_library_source "$lib") || continue
			record_ldd "$source"
		done < "$FASTLIB_PREVIOUS"

		parse_ldd_names "$FASTLIB_NEED" > "$FASTLIB_NEW"
		cat "$FASTLIB_PREVIOUS" "$FASTLIB_NEW" | sort -u > "$FASTLIB_KEEP"

		cmp -s "$FASTLIB_PREVIOUS" "$FASTLIB_KEEP" && break
	done
}

copy_missing_retained_libraries()
{
	local lib source

	while IFS= read -r lib; do
		[ -n "$lib" ] || continue
		target_library "$lib" >/dev/null && continue

		source=$(find_library_source "$lib") || {
			echo "WARNING: retained library dependency not found: $lib" >&2
			continue
		}

		mkdir -p "$LIB64_DIR"
		cp -L --preserve=mode,timestamps "$source" "$LIB64_DIR/$lib"
	done < "$FASTLIB_KEEP"
}

collect_early_dependencies()
{
	local item path

	: > "$FASTLIB_NEED"

	while IFS= read -r item; do
		[ -n "$item" ] || continue
		for path in "$BIN_DIR/$item" "$SBIN_DIR/$item"; do
			[ -e "$path" ] || continue
			record_ldd "$path"
		done
	done < <(read_list "$FASTBOOT_DIR/bin-boot")

	for path in "$LIB64_DIR"/plymouth/*.so "$LIB64_DIR"/plymouth/renderers/drm.so "$LIB64_DIR"/security/*; do
		[ -e "$path" ] || continue
		record_ldd "$path"
	done

	expand_retained_library_dependencies
}

is_core_runtime_library()
{
	case "$1" in
		libgcc_s.so.*|libnss_files.so.*|libnss_dns.so.*)
			return 0
			;;
	esac
	return 1
}

prepare_vendor_tree()
{
	local item

	mkdir -p "$LIB64_DIR/etc" var

	# Keep historical ThinStation top-level compatibility paths, but put their
	# immutable payload under /usr so one squash contains the vendor OS.
	for item in opt jre lib32; do
		[ -e "$item" ] || continue
		rm -rf "$LIB64_DIR/$item"
		mv "$item" "$LIB64_DIR/"
		ln -sf "/usr/lib64/$item" "$item"
	done

	while IFS= read -r item; do
		[ -e "etc/$item" ] || continue
		rm -rf "$LIB64_DIR/etc/$item"
		mv "etc/$item" "$LIB64_DIR/etc/"
		ln -sf "/usr/lib64/etc/$item" "etc/$item"
	done < <(read_list "$FASTBOOT_DIR/etc-ro")

	while IFS= read -r item; do
		[ -e "$LIB64_DIR/$item" ] || continue
		rm -rf "var/$item"
		mv "$LIB64_DIR/$item" var/
		ln -sf "/var/$item" "$LIB64_DIR/$item"
	done < <(read_list "$FASTBOOT_DIR/lib-rw")
}

stage_deferred_usr()
{
	rm -rf "$DEFERRED_DIR"
	mkdir -p "$DEFERRED_DIR"
	cp -a --reflink=auto "$USR_DIR" "$DEFERRED_DIR/usr"
}

remove_early_from_deferred()
{
	local path rel

	while IFS= read -r -d '' path; do
		rel=${path#./}
		rm -f "$DEFERRED_DIR/$rel"
	done < <(find "$USR_DIR" \( -type f -o -type l \) -print0)

	find "$DEFERRED_DIR/usr" -depth -type d -empty -delete
}

same_symlink()
{
	local early="$1"
	local deferred="$2"

	[ -L "$early" ] && [ -L "$deferred" ] || return 1
	[ "$(readlink "$early")" = "$(readlink "$deferred")" ]
}

subtree_is_all_early()
{
	local rel="$1"
	local deferred="$DEFERRED_DIR/$rel"
	local leaf leaf_rel early_leaf

	[ -d "$deferred" ] || return 1

	while IFS= read -r -d '' leaf; do
		leaf_rel=${leaf#"$DEFERRED_DIR/"}
		early_leaf="$leaf_rel"

		if [ -L "$leaf" ]; then
			# Relative links are location-sensitive. Keep their containing tree
			# in the logical /usr hierarchy and fall back to leaf links.
			case "$(readlink "$leaf")" in
				/*) ;;
				*) return 1 ;;
			esac

			# A deferred absolute symlink can be covered by a directory link only
			# when the early tree contains the exact same symlink.
			same_symlink "$early_leaf" "$leaf" || return 1
		elif [ -f "$leaf" ]; then
			# Executable trees stay at their logical /usr location. Programs may
			# discover their physical path (for example via /proc/self/exe) and
			# derive helpers/resources from it, so moving the containing directory
			# below /fastboot is not namespace-equivalent even when symlinks are.
			[ -x "$leaf" ] && return 1

			# Match the historical true-mode rule: only real early files are
			# candidates for relocation through /fastboot. BusyBox applet
			# symlinks created by relink_busybox must not replace deferred
			# real utilities.
			[ -f "$early_leaf" ] && [ ! -L "$early_leaf" ] || return 1
		fi
	done < <(find "$deferred" \( -type f -o -type l \) -print0)

	return 0
}

absolutize_relative_links()
{
	local root="$1"
	local logical_root="$2"
	local link target link_rel logical_dir absolute

	while IFS= read -r -d '' link; do
		target=$(readlink "$link")
		case "$target" in
			.|./) continue ;;
			/*) continue ;;
		esac

		link_rel=${link#"$root/"}
		logical_dir=$(dirname "/usr/$logical_root/$link_rel")
		absolute=$(realpath -m -s "$logical_dir/$target")
		ln -snf "$absolute" "$link"
	done < <(find "$root" -type l -print0)
}

link_early_path()
{
	local rel="$1"
	local path="$rel"
	local target="/fastboot/$rel"
	local deferred="$DEFERRED_DIR/$rel"

	mkdir -p "fastboot/$(dirname "$rel")" "$(dirname "$deferred")"

	# A directory moved below /fastboot changes the resolution base of any
	# relative symlink inside it. Rewrite those links to their equivalent
	# absolute logical /usr targets before moving the directory.
	if [ -d "$path" ] && [ ! -L "$path" ]; then
		absolutize_relative_links "$path" "${rel#usr/}"
	fi

	mv "$path" "fastboot/$rel"
	ln -s "$target" "$path"

	rm -rf "$deferred"
	ln -s "$target" "$deferred"
}

collapse_early_tree()
{
	local dir="$1"
	local child rel

	while IFS= read -r -d '' child; do
		rel=${child#./}

		if [ -d "$child" ] && [ ! -L "$child" ]; then
			if subtree_is_all_early "$rel"; then
				link_early_path "$rel"
			else
				collapse_early_tree "$child"
			fi
		elif [ -f "$child" ] && [ ! -L "$child" ]; then
			# Preserve existing true-mode semantics: relocate physical early
			# files only. Existing symlinks stay where the complete vendor
			# snapshot put them.
			link_early_path "$rel"
		fi
	done < <(find "$dir" -mindepth 1 -maxdepth 1 -print0)
}

link_early_through_fastboot()
{
	rm -rf fastboot/usr
	mkdir -p fastboot/usr

	# Collapse fully-early subtrees into directory links where that is exactly
	# equivalent to the historical leaf-by-leaf map. Mixed trees recurse until
	# only physical early regular files are linked individually.
	collapse_early_tree "$USR_DIR"
}

make_usr_squash()
{
	local output=../$INITDIR/lib.squash

	if [ "$HARDLINK" = "true" ]; then
		hardlink "$DEFERRED_DIR"
	fi

	echo -e "	Making split /usr lib.squash"
	mksquashfs "$DEFERRED_DIR" "$output" -always-use-fragments -no-recovery -noappend $FB_COMP_EXTRA
}


prune_early_binaries()
{
	local item file

	for item in "$BIN_DIR"/* "$SBIN_DIR"/*; do
		[ -e "$item" ] || [ -L "$item" ] || continue
		file=${item##*/}
		is_listed "$file" "$FASTBOOT_DIR/bin-boot" && continue
		rm -rf "$item"
	done
}

prune_early_fonts()
{
	local path

	if [ -d "$SHARE_DIR/fonts/dejavu-sans-fonts" ]; then
		for path in "$SHARE_DIR"/fonts/dejavu-sans-fonts/*; do
			[ -e "$path" ] || continue
			[ "${path##*/}" = "DejaVuSans-Bold.ttf" ] && continue
			rm -rf "$path"
		done
	fi

	if [ -d "$SHARE_DIR/fonts" ]; then
		for path in "$SHARE_DIR"/fonts/*; do
			[ -e "$path" ] || continue
			[ "${path##*/}" = "dejavu-sans-fonts" ] && continue
			rm -rf "$path"
		done
	fi

	if [ -d "$SHARE_DIR/fontconfig/conf.avail" ]; then
		for path in "$SHARE_DIR"/fontconfig/conf.avail/*; do
			[ -e "$path" ] || continue
			[ "${path##*/}" = "57-dejavu-sans-fonts.conf" ] && continue
			rm -rf "$path"
		done
	fi
}

prune_early_libraries()
{
	local item lib

	for item in "$LIB64_DIR"/*; do
		[ -e "$item" ] || [ -L "$item" ] || continue
		lib=${item##*/}

		case "$lib" in
			dbus-1|fonts|fontconfig)
				continue
				;;
		esac

		is_listed "$lib" "$FASTBOOT_DIR/lib-boot" && continue
		grep -Fxq "$lib" "$FASTLIB_KEEP" && continue
		is_core_runtime_library "$lib" && continue

		rm -rf "$item"
	done

	prune_early_fonts
}

prune_early_share()
{
	local item name
	for item in "$SHARE_DIR"/*; do
		[ -e "$item" ] || [ -L "$item" ] || continue
		name=${item##*/}
		is_listed "$name" "$FASTBOOT_DIR/lib-boot" && continue
		case "$name" in
			fonts|fontconfig) continue ;;
		esac
		rm -rf "$item"
	done
}

prune_early_usr()
{
	prune_early_binaries
	prune_early_libraries
	prune_early_share
}

relink_busybox()
{
	cd ..
	echo -e "	Re-Linking BusyBox
"
	chroot ./tmp-tree /bin/busybox.shared --install -s
	cd tmp-tree
}

prepare_vendor_tree

# lotsofmem must expand lib.squash before /usr exists, so unsquashfs is an
# early-boot-only tool for that mode.  Pull it from the build environment here;
# collect_early_dependencies() will retain its shared-library closure.
if [ "$FASTBOOT_MODE" = "lotsofmem" ]; then
	for tool in cp mv; do
		tool_source=$(command -v "$tool") || {
			echo "ERROR: fastboot=lotsofmem requires $tool" >&2
			exit 1
		}
		cp --remove-destination "$tool_source" "$BIN_DIR/$tool"
	done

	unsquashfs_source=$(command -v unsquashfs) || {
		echo "ERROR: fastboot=lotsofmem requires unsquashfs" >&2
		exit 1
	}
	cp --remove-destination "$unsquashfs_source" "$SBIN_DIR/unsquashfs"
fi

collect_early_dependencies

# lotsofmem injects host/build utilities (cp, mv, unsquashfs). Their shared
# libraries may not otherwise be part of the assembled ThinStation payload.
# Mirror the original fastboot behavior and copy those missing dependencies
# into the early /usr/lib64 tree before the split.
if [ "$FASTBOOT_MODE" = "lotsofmem" ]; then
	copy_missing_retained_libraries
fi

# Snapshot the complete vendor tree, then prune tmp-tree to the early subset.
stage_deferred_usr
prune_early_usr

case "$FASTBOOT_MODE" in
	true)
		relink_busybox
		link_early_through_fastboot
		;;
	lotsofmem)
		remove_early_from_deferred
		;;
	*)
		echo "Unsupported fastboot mode: $FASTBOOT_MODE" >&2
		exit 1
		;;
esac

make_usr_squash

cd ..
chmod 755 "$INITDIR/lib.squash"
cd tmp-tree
