#!/bin/bash
# Description: Thinstation Utility to install chroot for Thinstation Development
# URL: http://www.thinstation.org
# Maintainer: Donald A. Cupp Jr. (don cupp jr at ya hoo dot com)

DIST_VER="${DIST_VER:-44}"
MAX_PARALLEL_DOWNLOADS="${MAX_PARALLEL_DOWNLOADS:-3}"
MAX_DOWNLOADS_PER_MIRROR="${MAX_DOWNLOADS_PER_MIRROR:-3}"
TARGET_ARCH="${TARGET_ARCH:-$(uname -m)}"
CROSS_COMPILE="${CROSS_COMPILE:-false}"

case "$TARGET_ARCH" in
	amd64) TARGET_ARCH=x86_64 ;;
	arm64) TARGET_ARCH=aarch64 ;;
esac

dnf_common_opts=(
	--setopt=keepcache=1
	--setopt=max_parallel_downloads="$MAX_PARALLEL_DOWNLOADS"
	--setopt=max_downloads_per_mirror="$MAX_DOWNLOADS_PER_MIRROR"
	--releasever="$DIST_VER"
)

if [ "$CROSS_COMPILE" = "true" ]; then
	dnf_common_opts+=(--forcearch="$TARGET_ARCH")
fi

dnf_install()
{
	dnf install -y "${dnf_common_opts[@]}" "$@"
}

dnf_makecache()
{
	dnf makecache "${dnf_common_opts[@]}" "$@"
}

read_port_list()
{
	grep -v '^[[:space:]]*#' "$1" | sed ':a;N;$!ba;s/\n/ /g'
}

read_port_set()
{
	local name file ports=""

	for name in "$@"; do
		for file in "ts/rpms/$name" "ts/rpms/$name-$TARGET_ARCH"; do
			[ -f "$file" ] || continue
			ports="$ports $(read_port_list "$file")"
		done
	done

	printf '%s\n' "${ports# }"
}

core_ports="$(read_port_set core)"
boot_ports="$(read_port_set boot)"
kernel_ports="$(read_port_set kernel)"
firmware_ports="$(read_port_set firmware)"
system_ports="$(read_port_set system)"
ts_ports="$(read_port_set ts)"
other_ports="$(read_port_set other)"
extra_ports="${TS_EXTRA_PORTS:-}"

preserve_host_repo_overrides()
{
	local src marker id
	local -a replacements

	mkdir -p "$ROOT/etc/yum.repos.d"

	for src in /etc/yum.repos.d/*.repo; do
		[ -f "$src" ] || continue

		marker="$(grep -E '^# *thinstation-replaces=' "$src" | tail -n1 | cut -d= -f2- | tr -d '[:space:]')"
		[ -n "$marker" ] || continue

		echo "Preserving ThinStation host repository override: $src"
		cp -f "$src" "$ROOT/etc/yum.repos.d/"

		IFS=',' read -ra replacements <<< "$marker"
		for id in "${replacements[@]}"; do
			[ -n "$id" ] || continue

			for repo in "$ROOT"/etc/yum.repos.d/*.repo; do
				[ -f "$repo" ] || continue
				[ "$repo" = "$ROOT/etc/yum.repos.d/$(basename "$src")" ] && continue

				sed -i "/^\\[$id\\]$/,/^\\[/ s/^enabled=.*/enabled=0/" "$repo"
			done
		done
	done
}

stage1()
{
	local dir
	local -a host_config=()

	if dnf --version | head -n1 | grep -qe dnf5; then
		host_config=(--use-host-config)
	fi

	echo "Chroot not previously setup. Doing it NOW!"

	chown -R root:root ts setup-chroot README.md

	for dir in proc sys home dev mnt downloads var/cache/dnf; do
		if [ ! -e "$dir" ]; then
			mkdir -p -m 755 "$dir"
		fi
	done

	if [ ! -e tmp ]; then
		mkdir -m 1777 tmp
	fi

	if [ ! -e root ]; then
		mkdir -m 750 root
	fi

	if ! mountpoint dev >/dev/null 2>&1; then
		mount --bind /dev dev
	fi
	if ! mountpoint tmp >/dev/null 2>&1; then
		mount -t tmpfs /tmp tmp
	fi
	if ! mountpoint proc >/dev/null 2>&1; then
		mount -t proc proc proc
	fi
	if ! mountpoint sys >/dev/null 2>&1; then
		mount -t sysfs none sys
	fi

	ROOT=$PWD
	dnf_install \
		--installroot="$ROOT" \
		"${host_config[@]}" \
		$core_ports \
		$kernel_ports \
		$boot_ports \
		$firmware_ports \
		$system_ports \
		$other_ports \
		$extra_ports

	preserve_host_repo_overrides
	cd "$ROOT" || return 1
	touch "$ROOT/dostage2"
}

stage2()
{
	local procs

	cp -a /ts/repos/* /etc/yum.repos.d/.
	dnf_makecache
#	dnf_install $system_ports
	dnf_install --allowerasing $ts_ports #$other_ports

	for Root in $TSWRKNG $XTRWRKNG; do
		if [ "$Root" = "$TSWRKNG" ]; then
			export Cache=/ts
		else
			export Cache="$Root"
		fi

		export Root
		procs=$(($(nproc) - 1))
		ls --color=never "$Root/packages" |
			xargs -P "$procs" -I {} bash -c 'unwind_package "$@"' _ {}
	done

	printf "\rPackage Population %-40s\n" "Complete"
	echo "Populating tools"
	update -t

	cd "$TSWRKNG" || return 1
	./build --regenconf

	if [ ! -e /build ]; then
		ln -sf ts/build /build
	fi

	rm /dostage2
}

unwind_package()
{
	local pkg=$1

	printf "\rPopulating Package %-40s" "$pkg"
	cd "$Root/packages/$pkg" || return 1

	if [ -e .unwind ]; then
		if grep -e "#" .unwind | cut -d "#" -f2 | md5sum -c --quiet; then
			# Replaying an install cache must be idempotent. Remove only the
			# .dna-managed payload first, preserving manual package content.
			if [ -e .wind ] && grep -e "#" .wind | cut -d "#" -f2 | md5sum -c --quiet; then
				. .wind
			else
				update -c "$pkg"
			fi
			. .unwind
		else
			update "$pkg"
		fi
	else
		update "$pkg"
	fi
}

export -f unwind_package

ROOT=$PWD

if [ -e "$ROOT/dostage2" ]; then
	stage2
else
	stage1
fi
