	#	printf "\rPort Install scripts %-40s\n" "Complete"
	rm /dostage2
	touch /dostage3
}

stage3() {
	echo "STAGE 3: Installing packages and populating tools"
	cp -a /ts/repos/* /etc/yum.repos.d/.
	dnf makecache

	echo "Installing system packages"
	if ! $DNF_INSTALL $(get_rpms system); then
		echo "Failed to install system packages. Exiting."
		echo "Command was: $DNF_INSTALL $(get_rpms system)"
		exit 1
	fi

	echo "Installing TS packages"
	if ! $DNF_INSTALL --allowerasing $(get_rpms ts other); then
		echo "Failed to install TS packages. Exiting."
		echo "Command was: $DNF_INSTALL --allowerasing $(get_rpms ts other)"
		exit 1
	fi
	for Root in $TSWRKNG $XTRWRKNG; do
		if [ $Root = $TSWRKNG ]; then
			export Cache=/ts
		else
			export Cache=$Root
		fi
		export Root
		procs=$(nproc)
		let procs-=1
		ls --color=never $Root/packages | xargs -P $procs -I {} bash -c 'unwind_package "$@"' _ {}
	done
	printf "\rPackage Population %-40s\n" "Complete"
	echo "Populating tools"
	update -t
	cd $TSWRKNG
	./build --regenconf
	if [ ! -e /build ]; then
		ln -sf ts/build /build
	fi
	rm /dostage3
	touch /dostage4
}

unwind_package() {
	pkg=$1
	printf "\rPopulating Package %-40s" "$pkg"
	cd $Root/packages/$pkg
	if [ -e .unwind ]; then
		if cat .unwind | grep -e "#" | cut -d "#" -f2 | md5sum -c --quiet; then
			. .unwind
		else
			update $pkg
		fi
	else
		update $pkg
	fi
}

stage4() {
	rm /dostage4
	#	printf "\rLooking at core binary ports\n"
	#	procs=`nproc`
	#        let procs-=1
	#        for Root in $ROOT/ts $XTRWRKNG; do
