#!/bin/bash
# Description: Thinstation Utility to strip out extra files from a binary Package
# URL: http://www.thinstation.org
# Maintainer: Donald A. Cupp Jr. (don cupp jr at ya hoo dot com)

#set -x
show_help()
{
echo "
This utility is designed to simplify the folder layout of a crux port into a
ts package. It will decompress the compiled port archive that belongs to the
specified package and mangle it for integration into thinstation. By default,
the destination will be in $TSWRKNG/packages/(specified package) folder.
This can be overridden with the -t or --temp (path to temp folder)
syntax.

Usage: repackage (-t (path to temp folder)) (crux port)

"
}

get_opts()
{
	if [ -z "$1" ] ; then show_help ; exit 255 ; fi
	until [ -z "$1" ] ; do
		case "$1" in
			-h|--help)		show_help ; exit 255 ;;
			-t|--temp)		temp_folder="$2" ; shift ;;
			-e|--env)		from_env ; exit $? ;;
			-c|--clean)		clean ; exit $? ;;
			*)			package="$1" ;;
		esac
		shift
	done
}

package_path()
{
	if [ -n "$temp_folder" ] ; then
		pkgpath="$temp_folder/$package"
		return 0
	else
		pkgpath="$TSWRKNG/packages/$package"
		for work in $TSWRKNG $XTRWRKNG; do
			if [ -d "$work/packages/$package" ]; then
				pkgpath="$work/packages/$package"
				return 0
			fi
		done
		return 1
	fi
}

extract_scripts()
{
	local rpm_file="$1"
	local script_dir="$pkgpath/build/scripts"
	local rpm_name

	# Create script directory
	mkdir -p "$script_dir" || return $?

	# Extract all scripts into a temporary file
	if [ "$2" = installed ]; then
        rpm -q --scripts "$rpm_file" > all_scripts.txt || return $?
    else
        rpm -qp --scripts "$rpm_file" > all_scripts.txt || return $?
    fi

	# Extract the base RPM name without version
	rpm_name="${3:-$(basename "$rpm_file" | sed -r 's/-[0-9].*//')}"

	# Split the scripts into separate files
	csplit --digits=2 --quiet --prefix=script_ all_scripts.txt '/scriptlet (/' '{*}'
	rm all_scripts.txt

	# Process scripts
	for file in script_*; do
		local output_file=""
		if grep -q "preinstall scriptlet" "$file"; then
			output_file="$script_dir/${rpm_name}_preinstall.sh"
		elif grep -q "postinstall scriptlet" "$file"; then
			output_file="$script_dir/${rpm_name}_postinstall.sh"
		else
			rm "$file" # Remove unwanted scriptlets
			continue
		fi

		# Extract the interpreter and add a shebang
		local interpreter
		interpreter=$(grep -oP '(?<=scriptlet \(using ).*?(?=\))' "$file")
		if [ -n "$interpreter" ]; then
			echo "#!$interpreter" > "$output_file"
		else
			echo "#!/bin/sh" > "$output_file"
		fi

		# Append script content, skipping the header line
		sed '1d' "$file" >> "$output_file"
		rm "$file" # Clean up temporary split file
		sed -i 's/^\s*exit\s\+0\s*$/:/g' "$output_file"
	done
	if [ -z "`ls -A $pkgpath/build/scripts`" ]; then
		rmdir $pkgpath/build/scripts
	fi
	if [ -z "`ls -A $pkgpath/build`" ]; then
                rmdir $pkgpath/build
        fi
}

apply_caps() {
    if [ -e $pkgpath/file_caps.txt ]; then
	    while IFS= read -r line; do
        	if [[ "$line" =~ ^(.+?)\ (.+)$ ]]; then
	            file="${BASH_REMATCH[1]}"
	            caps="${BASH_REMATCH[2]}"
	            if [[ -n "$caps" && -e "$pkgpath/$file" ]] && [[ "$caps" != '(none)' ]]; then
	                setcap "$caps" "$pkgpath/$file" || return $?
	            fi
	        fi
	    done < $pkgpath/file_caps.txt
    fi
    rm -f $pkgpath/file_caps.txt
}


# When an RPM is installed into the long-lived build chroot, copy its recorded
# payload directly. Unlike re-extracting the archive, this works with no RPM
# cache and never accidentally copies other packages' files from shared dirs.
extract_installed()
{
    local spec="$1" staging filename relative status=0
    staging="$(mktemp -d "${TMPDIR:-/tmp}/ts-repackage-installed.XXXXXXXX")" || return $?
    if ! rpm -q --qf '[%{FILENAMES}\n]' "$spec" > "$staging/paths"; then
        rm -rf -- "$staging"
        return 1
    fi
    : > "$staging/manifest"
    while IFS= read -r filename; do
        case "$filename" in
            /*) relative="${filename#/}" ;;
            *) echo "Invalid installed RPM path: $filename" >&2; status=1; break ;;
        esac
        case "/$relative/" in
            */../*) echo "Unsafe installed RPM path: $filename" >&2; status=1; break ;;
        esac
        if [ -e "$filename" ] || [ -L "$filename" ]; then
            printf '%s\0' "$relative" >> "$staging/manifest"
        fi
    done < "$staging/paths"
    if [ "$status" -eq 0 ] && [ -s "$staging/manifest" ]; then
        ( set -o pipefail
          tar -C / --xattrs --selinux --no-recursion --null -cf - -T "$staging/manifest" |
              tar -C "$pkgpath" --xattrs --selinux -xf -
        ) || status=$?
    fi
    rm -rf -- "$staging"
    return "$status"
}

# Do not trust glob prefixes: foo-*.rpm also matches foo-plugins-*.rpm.
# Always validate the RPM header and native/noarch architecture.
find_cached_rpm()
{
    local wanted="$1" arch="$2" root="$3" candidate meta rpm_name rpm_arch
    [ -d "$root" ] || return 1
    while IFS= read -r candidate; do
        [ -f "$candidate" ] || continue
        meta="$(rpm -qp --qf '%{NAME} %{ARCH}' "$candidate" 2>/dev/null)" || continue
        read -r rpm_name rpm_arch <<< "$meta"
        if [ "$rpm_name" = "$wanted" ] && { [ "$rpm_arch" = "$arch" ] || [ "$rpm_arch" = noarch ]; }; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done < <(find "$root" -type f \( -name "$wanted-*.$arch.rpm" -o -name "$wanted-*.noarch.rpm" \) -print 2>/dev/null | LC_ALL=C sort -r)
    return 1
}


# Probe available RPM metadata only after the installed/cache fast paths miss.
# DNF5 otherwise rejects native-qualified names for noarch-only packages.
select_available_arch()
{
    local wanted="$1" native="$2" candidates rpm_name rpm_arch has_native=0 has_noarch=0
    candidates="$(dnf -q repoquery --available --queryformat '%{name} %{arch}\n' "$wanted")" || return $?
    while read -r rpm_name rpm_arch; do
        [ "$rpm_name" = "$wanted" ] || continue
        case "$rpm_arch" in
            "$native") has_native=1 ;;
            noarch) has_noarch=1 ;;
        esac
    done <<< "$candidates"
    if [ "$has_native" -eq 1 ]; then printf '%s\n' "$native"; return 0; fi
    if [ "$has_noarch" -eq 1 ]; then printf 'noarch\n'; return 0; fi
    return 1
}

extract_archive()
{
    local archive rpm_file native_arch package_spec installed_spec dnf_cache cache_dir selected_arch

    if [ -n "$RPM" ]; then
        # Explicit external RPM: preserve archive-only behavior.
        archive="$(basename "$RPM" .rpm)"
        rpm_file="/build/wget_tmp/$archive.rpm"
        if [ ! -f "$rpm_file" ]; then
            echo "RPM not found: $rpm_file" >&2
            return 1
        fi
    else
        native_arch="$(rpm --eval '%{_arch}')" || return $?
        installed_spec=""
        for spec in "$package.$native_arch" "$package.noarch"; do
            if rpm -q "$spec" >/dev/null 2>&1; then
                installed_spec="$spec"
                break
            fi
        done

        dnf_cache="${TS_REPACKAGE_DNF_CACHE:-/var/cache/dnf}"
        cache_dir="$dnf_cache/thinstation-repackage/packages"
        rpm_file=""
        if [ -z "$installed_spec" ]; then
            rpm_file="$(find_cached_rpm "$package" "$native_arch" "$dnf_cache" || true)"

            # Try normal installation first. DNF must never erase or replace
            # conflicting packages to satisfy this request (--allowerasing is
            # deliberately absent). Installed RPMs are reused on later builds.
            if [ -n "$rpm_file" ]; then
                package_spec="$rpm_file"
            else
                # Probe once for native or noarch; a native-qualified name is
                # invalid for noarch-only packages. If metadata is unavailable,
                # retain the existing native/noarch fallback behavior.
                selected_arch="$(select_available_arch "$package" "$native_arch")" || selected_arch="$native_arch"
                package_spec="$package.$selected_arch"
            fi
            echo "Trying conflict-safe installation: $package_spec"
            if dnf install --setopt=keepcache=1 --setopt=install_weak_deps=False -y "$package_spec"; then
                for spec in "$package.$native_arch" "$package.noarch"; do
                    if rpm -q "$spec" >/dev/null 2>&1; then
                        installed_spec="$spec"
                        break
                    fi
                done
            fi
        fi

        if [ -n "$installed_spec" ]; then
            # No rpm2archive or cache lookup necessary for installed RPMs.
            mkdir -p "$pkgpath" || return $?
            echo "Reusing installed RPM payload: $installed_spec"
            extract_scripts "$installed_spec" installed "$package" || return $?
            extract_installed "$installed_spec" || return $?
            rpm -q --qf '[%{filenames} %{filecaps}\n]' "$installed_spec" > "$pkgpath/file_caps.txt" || return $?
            apply_caps || return $?
            rm -rf "$pkgpath/usr/lib/.build-id" "$pkgpath/usr/lib64/.build-id"
            if [ "$package" = ncurses ] && [ -d "$pkgpath/usr/lib64" ]; then
                find "$pkgpath/usr/lib64" -type l -name terminfo -delete
            fi
            return 0
        fi

        # An installation collision or unsupported transaction must not force
        # an erase. Extract the exact native/noarch RPM instead, with no solver.
        if [ -z "$rpm_file" ]; then
            mkdir -p "$cache_dir" || return $?
            echo "Downloading collision-safe RPM archive: $package"
            # Download only the discovered architecture. Keep a noarch
            # fallback if the native repository candidate disappears.
            selected_arch="${selected_arch:-$native_arch}"
            if ! dnf download --arch="$selected_arch" --destdir="$cache_dir" "$package"; then
                if [ "$selected_arch" = noarch ]; then return 1; fi
                dnf download --arch=noarch --destdir="$cache_dir" "$package" || return $?
            fi
            rpm_file="$(find_cached_rpm "$package" "$native_arch" "$cache_dir" || true)"
        fi
        if [ -z "$rpm_file" ] || [ ! -f "$rpm_file" ]; then
            echo "Unable to locate native/noarch RPM for $package" >&2
            return 1
        fi
    fi

    mkdir -p "$pkgpath" || return $?
    extract_scripts "$rpm_file" || return $?
    ( set -o pipefail; rpm2archive "$rpm_file" | tar --xattrs --selinux -xzf - -C "$pkgpath" ) || return $?
    rpm -qp --qf '[%{filenames} %{filecaps}\n]' "$rpm_file" > "$pkgpath/file_caps.txt" || return $?
    apply_caps || return $?

    rm -rf "$pkgpath/usr/lib/.build-id" "$pkgpath/usr/lib64/.build-id"
    if [ -d "$pkgpath/usr/lib" ] && [ -z "$(ls -A "$pkgpath/usr/lib")" ]; then
        rmdir "$pkgpath/usr/lib"
    fi
    if [ -d "$pkgpath/usr/lib64" ] && [ -z "$(ls -A "$pkgpath/usr/lib64")" ]; then
        rmdir "$pkgpath/usr/lib64"
    fi
    if [ "$package" = ncurses ] && [ -d "$pkgpath/usr/lib64" ]; then
        find "$pkgpath/usr/lib64" -type l -name terminfo -delete
    fi
}

preserve_empty_working()
{
	for usefuldir in `find $pkgpath -type d -empty`; do
		touch $usefuldir/.gitignore
	done
}

canonicalize_usr()
{
    # Normalize package payload into the usr-merged layout.
    merge_tree()
    {
        local src="$1" dst="$2"
        if [ -d "$src" ] && [ -n "$(ls -A "$src")" ]; then
            mkdir -p "$dst"
            cp -a "$src"/. "$dst"/. || return $?
            rm -rf "$src"
        fi
    }

    merge_tree "$pkgpath/bin" "$pkgpath/usr/bin" || return $?
    merge_tree "$pkgpath/sbin" "$pkgpath/usr/bin" || return $?

    # Modern merged-bin layout has one executable namespace. Do not let
    # upstream RPMs reintroduce /usr/sbin into ThinStation packages.
    if [ -L "$pkgpath/usr/sbin" ]; then
        rm -f "$pkgpath/usr/sbin"
    elif [ -d "$pkgpath/usr/sbin" ]; then
        merge_tree "$pkgpath/usr/sbin" "$pkgpath/usr/bin" || return $?
    fi

    merge_tree "$pkgpath/lib" "$pkgpath/usr/lib64" || return $?
    merge_tree "$pkgpath/lib64" "$pkgpath/usr/lib64" || return $?
    merge_tree "$pkgpath/libexec" "$pkgpath/usr/libexec" || return $?
    merge_tree "$pkgpath/share" "$pkgpath/usr/share" || return $?

    # /usr/lib can contain multilib payload even during a native 64-bit
    # transaction. Never promote ELF32 objects into /usr/lib64.
    if [ -d "$pkgpath/usr/lib" ]; then
        mkdir -p "$pkgpath/usr/lib64"

        while IFS= read -r -d '' dir; do
            rel="${dir#$pkgpath/usr/lib/}"
            [ "$dir" = "$pkgpath/usr/lib" ] || mkdir -p "$pkgpath/usr/lib64/$rel"
        done < <(find "$pkgpath/usr/lib" -type d -print0)

        while IFS= read -r -d '' obj; do
            rel="${obj#$pkgpath/usr/lib/}"
            dst="$pkgpath/usr/lib64/$rel"
            mkdir -p "$(dirname "$dst")"

            candidate="$obj"
            if [ -L "$obj" ]; then
                resolved="$(readlink -f "$obj" 2>/dev/null || true)"
                [ -n "$resolved" ] && candidate="$resolved"
            fi

            if [ -f "$candidate" ]; then
                magic="$(od -An -t x1 -N4 "$candidate" 2>/dev/null | tr -d ' \n')"
                class="$(od -An -t u1 -j4 -N1 "$candidate" 2>/dev/null | tr -d ' ')"
                if [ "$magic" = "7f454c46" ] && [ "$class" = "1" ]; then
                    echo "Skipping ELF32 object during usr/lib -> usr/lib64 merge: $obj"
                    continue
                fi
            fi

            cp -a "$obj" "$dst" || return $?
        done < <(find "$pkgpath/usr/lib" -mindepth 1 ! -type d -print0)

        rm -rf "$pkgpath/usr/lib"
    fi

}

move_run()
{
	if [ -e $pkgpath/var/run ]; then
		cp -a $pkgpath/var/run $pkgpath/.
		rm -rf $pkgpath/var/run
	fi
}

extra_dirs()
{
	extra_dirs="man doc docs info pkgconfig aclocal gtk-doc help vala gir-1.0 bash-completion cmake omf examples example samples tests test testing demos demo benchmarks benchmark"
	if [ "$package" != "python" ] ; then
		extra_dirs="$extra_dirs include"
	fi
	for extra_dir in $extra_dirs ; do
		if [ -d $pkgpath/$extra_dir ] ; then
			rm -rf $pkgpath/$extra_dir
		fi
		if [ -d $pkgpath/usr/$extra_dir ] ; then
			rm -rf $pkgpath/usr/$extra_dir
		fi
		if [ -d $pkgpath/usr/local/$extra_dir ] ; then
			rm -rf $pkgpath/usr/local/$extra_dir
		fi
		if [ -d $pkgpath/usr/share/$extra_dir ] ; then
			rm -rf $pkgpath/usr/share/$extra_dir
		fi
		if [ -d $pkgpath/usr/lib64/$extra_dir ] ; then
			rm -rf $pkgpath/usr/lib64/$extra_dir
		fi
	done
	for include in include ; do
		if [ -d $pkgpath/usr/$include ] ; then
			mkdir -p $pkgpath/usr/lib64
			cp -a $pkgpath/usr/$include/* $pkgpath/usr/lib64/.
			rm -rf $pkgpath/usr/$include
			ln -sf /usr/lib64 $pkgpath/usr/$include
		fi
	done
}

extra_files()
{
	find $pkgpath -name *.a -delete
	find $pkgpath -name *.la -delete

	# The runtime dynamic linker consumes /etc/ld.so.cache.  The auxiliary
	# ldconfig cache is only an optimization for future ldconfig runs and is
	# not required in the immutable ThinStation image.
	rm -f $pkgpath/var/cache/ldconfig/aux-cache
}

remove_empty()
{
	find $pkgpath -type d -empty -delete
}

clean()
{
	package=$PACKAGE
	if [ -n "$PACKAGE" ] && package_path; then
		for object in `ls -A --color=never $pkgpath |grep -E -v 'build|.dna|.gitignore|.wind|.unwind|dependencies|configurator.yaml|session_configurator.yaml'`; do
			rm -rf $pkgpath/$object
		done
		rm -f $pkgpath/build/installed
		rm -rf $pkgpath/build/scripts
	else
		echo "$PACKAGE does not exist"
		exit 1
	fi
}

cut_bloat()
{
	for bloat in $DROP_FILES; do
		find $INSTALLDIR -type f -name $bloat -delete
	done
	for bloat in $DROP_FILES; do
		find $INSTALLDIR -type l -name $bloat -delete
	done
	for bloat in $DROP_DIRS; do
		# DROP_DIRS predates usr-merge. Accept legacy flattened paths and
		# remove their canonical /usr equivalents as well.
		rel=`echo "$bloat" | sed -e "s|^/||"`
		case "$rel" in
			bin) rm -rf "$INSTALLDIR/bin" "$INSTALLDIR/usr/bin" ;;
			bin/*)
				x=`echo "$rel" | sed -e "s|^bin/||"`
				rm -rf "$INSTALLDIR/bin/$x" "$INSTALLDIR/usr/bin/$x"
				;;
			sbin) rm -rf "$INSTALLDIR/sbin" "$INSTALLDIR/usr/sbin" ;;
			sbin/*)
				x=`echo "$rel" | sed -e "s|^sbin/||"`
				rm -rf "$INSTALLDIR/sbin/$x" "$INSTALLDIR/usr/sbin/$x"
				;;
			share) rm -rf "$INSTALLDIR/share" "$INSTALLDIR/usr/share" ;;
			share/*)
				x=`echo "$rel" | sed -e "s|^share/||"`
				rm -rf "$INSTALLDIR/share/$x" "$INSTALLDIR/usr/share/$x"
				;;
			libexec) rm -rf "$INSTALLDIR/libexec" "$INSTALLDIR/usr/libexec" ;;
			libexec/*)
				x=`echo "$rel" | sed -e "s|^libexec/||"`
				rm -rf "$INSTALLDIR/libexec/$x" "$INSTALLDIR/usr/libexec/$x"
				;;
			lib|lib64)
				rm -rf "$INSTALLDIR/lib" "$INSTALLDIR/lib64" "$INSTALLDIR/usr/lib" "$INSTALLDIR/usr/lib64"
				;;
			lib/*|lib64/*)
				x=`echo "$rel" | sed -e "s|^lib64/||" -e "s|^lib/||"`
				rm -rf "$INSTALLDIR/lib/$x" "$INSTALLDIR/lib64/$x" "$INSTALLDIR/usr/lib64/$x" "$INSTALLDIR/usr/share/$x"
				;;
			*)
				rm -rf "$INSTALLDIR/$rel" 				       "$INSTALLDIR/usr/$rel" 				       "$INSTALLDIR/usr/share/$rel" 				       "$INSTALLDIR/usr/lib64/$rel"
				;;
		esac
	done
}

create_empty()
{
	for folder in $CREATE_EMPTY_DIRS; do
		mkdir -p $INSTALLDIR/$folder
	done
}

merge_trunk()
{
	if [ -e $INSTALLDIR/build/extra ]; then
		for dir in `find $INSTALLDIR/build/extra -type d -printf "%P\n"`; do
			mkdir -p $INSTALLDIR/$dir
		done
		IFS=$'\n\t'
		for file in `find $INSTALLDIR/build/extra ! -type d -printf "%P\n"`; do
			if [ -e $INSTALLDIR/"$file" ]; then
				rm $INSTALLDIR/"$file"
			fi
			ln $INSTALLDIR/build/extra/"$file" $INSTALLDIR/"$file"
		done
		unset IFS
	fi
}

from_env()
{
    local project
    INSTALLDIR=""
    for project in $TSWRKNG $XTRWRKNG; do
        if [ -d "$project/packages/$PACKAGE" ]; then
            INSTALLDIR="$project/packages/$PACKAGE"
        fi
    done
    [ -n "$INSTALLDIR" ] || { echo "Unknown package: $PACKAGE" >&2; return 1; }
    rm -f "$INSTALLDIR/build/installed" || return $?
    # Isolated staging avoids leftovers and collisions between invocations.
    temp_folder=$(mktemp -d "./build-$PACKAGE.XXXXXX") || return $?
    local status=0
    for package in $PORTS $RPM; do
        main || { status=$?; break; }
        cp -a "$temp_folder/$package/." "$INSTALLDIR/" || { status=$?; break; }
    done
    rm -rf "$temp_folder"
    [ "$status" -eq 0 ] || return "$status"
    cut_bloat || return $?
    create_empty || return $?
    merge_trunk || return $?
    touch "$INSTALLDIR/build/installed"
}

reduce_libs()
{
    python3 "${TS_LIBRARY_HELPER:-$(dirname "$(readlink -f "$0")")/ts-library-deps}" reduce "$pkgpath"
}

remove_libs()
{
	if [ -e $pkgpath/usr/lib64 ]; then
		find $pkgpath/usr/lib64 -mindepth 1 -maxdepth 1 -name lib\*.so\* -delete
	fi
}

main()
{
    package_path || return $?
    extract_archive || return $?
    preserve_empty_working || return $?
    canonicalize_usr || return $?
    move_run || return $?
    extra_dirs || return $?
    extra_files || return $?
    remove_empty || return $?
    reduce_libs || return $?
}

get_opts "$@"
echo "$package"
main "$@"
exit $?
